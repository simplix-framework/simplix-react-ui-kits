{
  "name": "@simplix-react-ui-kits/mockup",
  "version": "0.1.0-SNAPSHOT",
  "description": "Mockup tooling for simplix-react products: the Storybook preview and preset a mockup root runs, the checks its screens pass, and the generator of a new root",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simplix-framework/simplix-react-ui-kits.git",
    "directory": "packages/mockup"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./preview": {
      "source": "./src/preview.tsx",
      "types": "./src/preview.tsx",
      "import": "./dist/preview.js"
    },
    "./settings": {
      "source": "./src/settings.tsx",
      "types": "./src/settings.tsx",
      "import": "./dist/settings.js"
    },
    "./preset": "./storybook/preset.mjs",
    "./vite-plugin": "./lib/vite-plugin.mjs",
    "./screen-design": "./lib/screen-design.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "simplix-mockup": "bin/simplix-mockup.mjs"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "checks",
    "lib",
    "storybook",
    "scaffold",
    "!lib/*.test.mjs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --no-clean --no-dts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src lib checks bin storybook",
    "test": "node --test lib/*.test.mjs",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "playwright": "catalog:",
    "postcss": "^8.5.0"
  },
  "peerDependencies": {
    "@simplix-react/headless": ">=0.3.0",
    "@storybook/react": ">=10.0.0",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-router-dom": ">=7.0.0",
    "simplix-react": ">=0.3.0",
    "storybook": ">=10.0.0",
    "typescript": ">=5.0.0",
    "vite": ">=7.0.0"
  },
  "devDependencies": {
    "@simplix-react/headless": "catalog:",
    "@storybook/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "simplix-react": "catalog:",
    "storybook": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "simplix": {
    "mockupRoot": {
      "dependencies": [
        "@storybook/react",
        "@tanstack/react-query",
        "i18next",
        "react",
        "react-dom",
        "react-i18next",
        "react-router-dom",
        "storybook"
      ],
      "devDependencies": [
        "@storybook/addon-a11y",
        "@storybook/react-vite",
        "@tailwindcss/vite",
        "@types/react",
        "@types/react-dom",
        "storybook-addon-pseudo-states",
        "tailwindcss",
        "typescript",
        "vite"
      ]
    }
  }
}

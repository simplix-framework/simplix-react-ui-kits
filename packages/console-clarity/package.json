{
  "name": "@simplix-react-ui-kits/console-clarity",
  "version": "0.0.1",
  "private": true,
  "description": "Console UI kit, clarity design: the console parts drawn with hairline borders, one accent and hierarchy from type, defaulting every console to the clarity design",
  "type": "module",
  "sideEffects": [
    "**/locales/**",
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./api": {
      "source": "./src/api/index.ts",
      "types": "./src/api/index.ts",
      "import": "./dist/api/index.js"
    },
    "./attachment": {
      "source": "./src/attachment/index.ts",
      "types": "./src/attachment/index.ts",
      "import": "./dist/attachment/index.js"
    },
    "./badge": {
      "source": "./src/badge/index.ts",
      "types": "./src/badge/index.ts",
      "import": "./dist/badge/index.js"
    },
    "./clipboard": {
      "source": "./src/clipboard/index.ts",
      "types": "./src/clipboard/index.ts",
      "import": "./dist/clipboard/index.js"
    },
    "./clipboard/fallback": {
      "source": "./src/clipboard/fallback.ts",
      "types": "./src/clipboard/fallback.ts",
      "import": "./dist/clipboard/fallback.js"
    },
    "./dashboard": {
      "source": "./src/dashboard/index.ts",
      "types": "./src/dashboard/index.ts",
      "import": "./dist/dashboard/index.js"
    },
    "./datetime": {
      "source": "./src/datetime/index.ts",
      "types": "./src/datetime/index.ts",
      "import": "./dist/datetime/index.js"
    },
    "./entity": {
      "source": "./src/entity/index.ts",
      "types": "./src/entity/index.ts",
      "import": "./dist/entity/index.js"
    },
    "./error": {
      "source": "./src/error/index.ts",
      "types": "./src/error/index.ts",
      "import": "./dist/error/index.js"
    },
    "./i18n": {
      "source": "./src/i18n/index.ts",
      "types": "./src/i18n/index.ts",
      "import": "./dist/i18n/index.js"
    },
    "./identity": {
      "source": "./src/identity/index.ts",
      "types": "./src/identity/index.ts",
      "import": "./dist/identity/index.js"
    },
    "./layout": {
      "source": "./src/layout/index.ts",
      "types": "./src/layout/index.ts",
      "import": "./dist/layout/index.js"
    },
    "./manual": {
      "source": "./src/manual/index.ts",
      "types": "./src/manual/index.ts",
      "import": "./dist/manual/index.js"
    },
    "./mock": {
      "source": "./src/mock/index.ts",
      "types": "./src/mock/index.ts",
      "import": "./dist/mock/index.js"
    },
    "./notice": {
      "source": "./src/notice/index.ts",
      "types": "./src/notice/index.ts",
      "import": "./dist/notice/index.js"
    },
    "./page": {
      "source": "./src/page/index.ts",
      "types": "./src/page/index.ts",
      "import": "./dist/page/index.js"
    },
    "./peek": {
      "source": "./src/peek/index.ts",
      "types": "./src/peek/index.ts",
      "import": "./dist/peek/index.js"
    },
    "./screen": {
      "source": "./src/screen/index.ts",
      "types": "./src/screen/index.ts",
      "import": "./dist/screen/index.js"
    },
    "./shell": {
      "source": "./src/shell/index.ts",
      "types": "./src/shell/index.ts",
      "import": "./dist/shell/index.js"
    },
    "./styles/*": "./src/styles/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 tsup",
    "dev": "tsup --no-clean --no-dts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run && pnpm test:kit && pnpm test:templates",
    "clean": "rm -rf dist .turbo",
    "design:css": "simplix-design-css --root ../console-core --design-spec ../console-clarity/src/styles/designs/clarity.spec.ts --out ../console-clarity/src/styles/designs/clarity.css --compiled ../console-clarity/src/styles/designs/clarity-stylesheet.ts --tailwind-from ../../../simplix-react/apps/storybook --reference src/styles/utilities.css",
    "design:check": "simplix-design-css --root ../console-core --design-spec ../console-clarity/src/styles/designs/clarity.spec.ts --out ../console-clarity/src/styles/designs/clarity.css --compiled ../console-clarity/src/styles/designs/clarity-stylesheet.ts --tailwind-from ../../../simplix-react/apps/storybook --reference src/styles/utilities.css --check && simplix-design-coverage ../console-core/src/styles/designs/classic.css src/styles/designs/clarity.css && simplix-design-literals src",
    "test:templates": "node ../../testing/template-harness/harness.mjs .",
    "test:kit": "KIT_DIR=. vitest run --config ../console-core/tests/kit/vitest.config.ts"
  },
  "dependencies": {
    "@simplix-react-ui-kits/console-core": "workspace:*",
    "simplix-react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@tanstack/react-query": ">=5.0.0",
    "@tanstack/react-router": ">=1.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "simplix": {
    "extends": "@simplix-react-ui-kits/console-core",
    "id": "clarity",
    "fence": [
      {
        "name": "@simplix-react/ui",
        "importNames": [
          "CrudList",
          "ListDetail",
          "CrudDetail",
          "CrudForm",
          "useCrudPageState",
          "useCrudNavigation",
          "ChipFilter"
        ],
        "message": "Screens compose the console kit's parts (CrudPage, RecordList, RecordDetail, RecordForm from @simplix-react-ui-kits/console-clarity), never the framework's screen-composition parts directly. A screen's own chip narrowing is the list's `narrowing` data, never a ChipFilter it draws."
      },
      {
        "name": "@simplix-react-ui-kits/console-clarity/layout",
        "importNames": [
          "SettingsTiles",
          "TilesCollapseProvider",
          "useTilesCollapse"
        ],
        "message": "A screen hands its figures to the page as spec.tiles; the page shell draws the figure row and its one fold. Never draw SettingsTiles or a tile fold yourself."
      },
      {
        "name": "@simplix-react-ui-kits/console-clarity/datetime",
        "importNames": [
          "ListTimeRange",
          "PageTimeRange"
        ],
        "message": "A screen switches the time range region on with data (blocks `timeRange: { field, presets?, counts? }`); the page template draws the strip. Never draw ListTimeRange yourself."
      },
      {
        "name": "@simplix-react-ui-kits/console-clarity/notice",
        "importNames": [
          "NoticeCard"
        ],
        "message": "A notice is data: spec.notice / notices on the page, notices on a tab, fallback for a page with nothing to show. The page draws every notice card; a screen never draws one."
      }
    ]
  }
}

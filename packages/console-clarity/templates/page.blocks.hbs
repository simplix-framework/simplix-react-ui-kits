/**
 * What `{{EntityPascal}}CrudPage` does differently from the generated page: the header's actions
 * (and those that read the list), tiles and tabs, the list's request and its props, the detail's
 * props, and dialogs. Written by hand and never regenerated.
 */
import type { ConsoleSearch, CrudPageBlocks } from "@simplix-react-ui-kits/console-clarity/page";

import type { {{EntityPascal}}DetailProps, {{EntityPascal}}ListProps, {{EntityPascal}}Row, use{{EntityPascal}}List } from "../../widgets/{{entityKebab}}";

/** The keys a screen may state, and what each one does, are the kit's `CrudPageBlocks`. */
export type PageBlocks = CrudPageBlocks<{{EntityPascal}}Row, {{EntityPascal}}ListProps, {{EntityPascal}}DetailProps, ReturnType<typeof use{{EntityPascal}}List>>;

export function usePageBlocks(_page: { readonly search: ConsoleSearch; readonly onNavigate: (search: ConsoleSearch) => void }): PageBlocks {
  // `spec.description`: the line under the title. Absent, it is the entity's description from
  // SimpliX Meta, empty until the backend states one. State one or two sentences where the screen's
  // task is rare or an action on it has a consequence to understand first; state `""` on a screen
  // read every day.
  // `cards`: the figures the list is cut by, `(list) => StatusCard[]`, each with the `filter` its
  // chip writes. `notices`: what the list's state raises, `(list) => CrudPageNotice[]`, each with
  // its `when`. The cards come first and the notices directly under them, both above the tabs
  // and the chip row.
  return {};
}

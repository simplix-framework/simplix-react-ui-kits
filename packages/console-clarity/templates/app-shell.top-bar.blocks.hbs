/**
 * @simplix-generated blocks/app-shell.top-bar.blocks
 * What the app's top-bar shell holds: its bar, what wraps the routed screens and the pages it draws
 * in place of the window for a refused self read.
 * Generated from the kit's app-shell.top-bar.blocks template and tracked: edit inside its keys, and a template change is merged into it three ways on regeneration.
 */
import type { ReactNode } from "react";
import { useTranslation } from "@simplix-react/i18n/react";
import { ConsoleBandTopBar, DarkModeToggle, LocalePicker, type ShellRefusalPages } from "@simplix-react-ui-kits/console-clarity/shell";

export interface ShellBlocks {
  /** The band across the top of the window: the mark, the destinations and the controls. */
  readonly topBar: ReactNode;
  /** The routes drawn without the window (sign-in and the pages around it). */
  readonly isOutsideTheShell: (route: string) => boolean;
  /** Providers the routed screen needs inside the window. */
  readonly wrap: (screen: ReactNode) => ReactNode;
  /**
   * The page drawn in place of the whole shell while the server refuses the signed-in identity's own
   * read, by the error code its envelope carries. Absent, no refusal changes the shell.
   */
  readonly refusalPages?: ShellRefusalPages;
}

/** The shell's parts for the route on screen, which the bar reads to mark where the reader stands. */
export function useShellBlocks(_route: string): ShellBlocks {
  const { t } = useTranslation("{{namespace}}");
  return {
    topBar: (
      <ConsoleBandTopBar mark={t("shell.title")}>
        <LocalePicker />
        <DarkModeToggle />
      </ConsoleBandTopBar>
    ),
    isOutsideTheShell: () => false,
    wrap: (screen) => screen,
  };
}

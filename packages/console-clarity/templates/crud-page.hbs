/**
 * @simplix-generated page/clarity-crud-page
 *
 * Laid down from the console-clarity kit's `crud-page.hbs` as the whole screen: its title and the
 * description its catalog states, the figures its Meta counts, the time range where its Meta names
 * one, the list with its row actions, the record, and the new and edit panels. The screen is
 * customised here, in this file, by hand; a later template change is merged into it three ways.
 *
 * <p>What the page departs in and states apart (its own notices, row verbs and their dialogs, header
 * actions that read the list, the request the list reads with) lives in `./page.blocks.tsx`, whose
 * `usePageBlocks` the page reads once here, typed by the kit's `CrudPageBlocks`. A key the blocks
 * leave out keeps the generated shape; a `spec` key the blocks state wins over the generated one.
 */
{{#if hasCreate}}
import type { ReactNode } from "react";
{{/if}}
import { useTranslation } from "@simplix-react/i18n/react";
import { CrudPage, {{#if hasCreate}}PageAction, {{/if}}type ConsoleSearch, type CrudNavigateOptions, type CrudPageBlocks, useDetailPresentationSetting } from "@simplix-react-ui-kits/console-clarity/page";
import { {{#if (or hasCreate hasUpdate hasDelete)}}useAllowed, {{/if}}{{#if hasDelete}}useAnnounceOutcome, {{#if displayNameField}}useRecordContract, {{/if}}{{/if}}{{#if figureTiles}}RECORD_READ_META, useFigureTiles, {{/if}}useScreenWords{{#if hasDelete}}{{#if displayNameField}}, type ContractField{{/if}}{{/if}} } from "@simplix-react-ui-kits/console-clarity/entity";
{{#if figureTiles}}
import { {{#if figureTiles.status}}{{figureTiles.status.hook}}{{/if}}{{#if figureTiles.status}}{{#if figureTiles.aggregates}}, {{/if}}{{/if}}{{#if figureTiles.aggregates}}{{figureTiles.aggregates.hook}}{{/if}} } from "{{packageName}}";
{{/if}}
{{#if hasDelete}}
import { adaptOrvalDelete, useCrudDeleteWired, useInvalidateEntity } from "@simplix-react/ui";
import { {{hookDelete}}{{#if entityPathExport}}, {{entityPathExport}}{{/if}} } from "{{packageName}}";
{{/if}}
{{#if accessCreate}}
import { {{accessCreate}} } from "{{packageName}}";
{{/if}}
{{#if accessUpdate}}
import { {{accessUpdate}} } from "{{packageName}}";
{{/if}}
{{#if accessDelete}}
import { {{accessDelete}} } from "{{packageName}}";
{{/if}}

import { {{EntityPascal}}Detail, {{#if hasForm}}{{EntityPascal}}Form, {{/if}}{{EntityPascal}}List, use{{EntityPascal}}List, type {{EntityPascal}}DetailProps, type {{EntityPascal}}ListProps, type {{EntityPascal}}Row } from "../../widgets/{{entityKebab}}";
import { usePageBlocks } from "./page.blocks";
{{#if timeBuckets}}
import { readCounts, type TimeRangeCountQuery } from "@simplix-react-ui-kits/console-clarity/datetime";
import { {{timeBuckets.fetch}} } from "{{packageName}}";
{{/if}}

interface {{EntityPascal}}CrudPageProps {
  readonly search: ConsoleSearch;
  /** Moves the address; a change the reader makes while staying on the list passes `{ replace: true }`. */
  readonly onNavigate: (search: ConsoleSearch, options?: CrudNavigateOptions) => void;
}

/** {{EntityPascal}}: the list, and the record it opens. */
{{#if hasDelete}}
{{#if displayNameField}}
/** The fields the record is named by, in order, each drawn by its kind. */
const NAME_FIELDS: readonly ContractField[] = [
{{#each nameContractFields}}
  { name: "{{this.name}}", kind: "{{this.contractKind}}"{{#if this.money}}, currency: "{{this.money.currency}}", scale: {{this.money.scale}}{{/if}}{{#if this.enumTypeName}}, enumName: "{{this.enumTypeName}}"{{/if}}{{#if this.nameField}}, nameField: "{{this.nameField}}"{{/if}}{{#if this.isCode}}, code: true{{/if}} },
{{/each}}
];

{{/if}}
{{/if}}
{{#if hasCreate}}
/** The header's actions: the generated create action, then the ones the blocks draw over the list. */
function headerActions(create: ReactNode, own: ReactNode): ReactNode {
  return create && own ? (
    <>
      {create}
      {own}
    </>
  ) : (create ?? own);
}

{{/if}}
export function {{EntityPascal}}CrudPage({ search, onNavigate }: {{EntityPascal}}CrudPageProps) {
  const words = useScreenWords("{{entity}}");
  // The line under the title is the screen's own, from its catalog; an empty value draws none.
  const { t } = useTranslation("{{moduleNamespace}}/widgets");
  // A key the catalog holds empty comes back as the key itself, and draws no line either.
  const line = t("screen.{{entity}}.description");
  const description = line && line !== "screen.{{entity}}.description" ? line : undefined;
  // The page's own departures (./page.blocks.tsx), read once and typed by the kit's list of keys.
  const blocks: ReturnType<typeof usePageBlocks> & CrudPageBlocks<{{EntityPascal}}Row, {{EntityPascal}}ListProps, {{EntityPascal}}DetailProps, ReturnType<typeof use{{EntityPascal}}List>> = usePageBlocks({ search, onNavigate });
  // The list keeps its filters in the page's address, so a link can open it filtered, Back leaves the
  // page in one step, and a reload keeps them. A change replaces the history entry.
  const list = use{{EntityPascal}}List(blocks.listParams, {
    value: search.filters,
    onChange: (next) => onNavigate({ ...search, filters: next }, { replace: true }),
  });
  const presentation = useDetailPresentationSetting();
{{#if figureTiles}}
  // The figures the entity's SimpliX Meta says it counts and sums, drawn as the page's figure row.
  // A failed read is told by the page's own notice (`figures.notices`), so the error dialog leaves both reads alone.
  const figures = useFigureTiles("{{entity}}", {
{{#if figureTiles.status}}
    status: { query: {{figureTiles.status.hook}}({ field: "{{figureTiles.status.field}}" }, { query: { meta: RECORD_READ_META } }), field: "{{figureTiles.status.field}}", enumName: "{{figureTiles.status.enumName}}", values: [{{#each figureTiles.status.options}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}]{{#if figureTiles.status.tones}}, tones: { {{#each figureTiles.status.tones}}"{{@key}}": "{{this}}"{{#unless @last}}, {{/unless}}{{/each}} }{{/if}} },
{{/if}}
{{#if figureTiles.aggregates}}
    aggregates: {
      // The sums are read over the rows the list is showing: its filters, search text and forced scope.
      query: {{figureTiles.aggregates.hook}}(list.requestParams as Parameters<typeof {{figureTiles.aggregates.hook}}>[0], { query: { meta: RECORD_READ_META } }),
      figures: [
{{#each figureTiles.aggregates.figures}}
        { field: { name: "{{this.field}}", kind: "{{this.kind}}"{{#if this.money}}, currency: "{{this.money.currency}}", scale: {{this.money.scale}}{{/if}}{{#if this.signed}}, signed: true{{/if}} }, op: "{{this.op}}"{{#if this.isRowCount}}, rowCount: true{{/if}} },
{{/each}}
      ],
    },
{{/if}}
    rowsLabel: words.plural,
  });
{{/if}}
{{#if (or hasCreate hasUpdate hasDelete)}}
  // Every control is gated on the rule its endpoint states, so none leads to a call the server refuses.
{{/if}}
{{#if hasCreate}}
  const canCreate = useAllowed({{#if accessCreate}}{{accessCreate}}{{else}}undefined{{/if}});
{{/if}}
{{#if hasUpdate}}
  const canEdit = useAllowed({{#if accessUpdate}}{{accessUpdate}}{{else}}undefined{{/if}});
{{/if}}
{{#if hasDelete}}
  const canDelete = useAllowed({{#if accessDelete}}{{accessDelete}}{{else}}undefined{{/if}});
{{/if}}
{{#if hasDelete}}
  const invalidate = useInvalidateEntity({{#if entityPathExport}}{{entityPathExport}}{{else}}"{{entityPath}}"{{/if}});
  const announce = useAnnounceOutcome();
  const { requestDelete, deleteDialog } = useCrudDeleteWired({
    deleteMutation: adaptOrvalDelete({{hookDelete}}(), "{{#if deletePathParam}}{{deletePathParam}}{{else}}{{rowIdField}}{{/if}}", { onSettled: invalidate }),
    labels: {
      title: () => words.deleteTitle,
      description: (target) => words.deleteDescription(target.name),
      cancel: words.cancel,
      delete: words.delete,
      deleting: words.deleting,
    },
    onDeleted: () => {
      announce({ message: words.deleted });
      // Back to the list the reader left: its tab and its filters stay, the record and the mode go.
      onNavigate({ tab: search.tab, filters: search.filters });
    },
  });
{{#if displayNameField}}
  // The record's name is every field its entity declares for it, each drawn by its kind, joined in order.
  const contract = useRecordContract("{{entity}}");
  const nameOf = (row: object) => contract.recordName(NAME_FIELDS, row as Readonly<Record<string, unknown>>);
{{else}}
  const nameOf = (row: { readonly {{rowIdField}}?: unknown }) => String(row.{{rowIdField}} ?? "");
{{/if}}
{{/if}}
{{#if timeBuckets}}
  // The entity's Meta names the field its rows are read by in time, so the page offers the time
  // range over it, counted per slice by the list's own counts read.
  const timeRange = {
    field: "{{timeBuckets.field}}",
    counts: (query: TimeRangeCountQuery) => readCounts({{timeBuckets.fetch}}({ ...query.conditions, from: query.from, to: query.to, buckets: query.buckets } as Parameters<typeof {{timeBuckets.fetch}}>[0])),
    filters: list.filters,
  };
{{/if}}

  return (
    <>
      <CrudPage
        spec={{ldb}}
          title: words.plural,
          description,
{{#if figureTiles}}
          tiles: figures.tiles,
          tilesLoading: figures.loading,
{{/if}}
{{#if hasCreate}}
          actions: headerActions(canCreate ? <PageAction kind="add" label={words.add} onClick={() => onNavigate({ ...search, mode: "new", id: undefined })} /> : undefined, blocks.headerActions?.(list)),
{{else}}
          actions: blocks.headerActions?.(list),
{{/if}}
          // A time range the blocks switch on is drawn over the list's own filters, as the generated one is.
          timeRange: blocks.timeRange ? { ...blocks.timeRange, filters: list.filters } : {{#if timeBuckets}}timeRange{{else}}undefined{{/if}},
          ...blocks.spec,
        {{rdb}}
        search={search}
        onNavigate={onNavigate}
        {...presentation}
        // The figures (`spec.tiles`) narrow the list through its own filter state.
        tileFilters={list.filters}
{{#if figureTiles}}
        notices={[...(blocks.notices?.(list) ?? []), ...figures.notices]}
{{else}}
        notices={blocks.notices?.(list)}
{{/if}}
        detailWidth={blocks.detailWidth}
        renderList={(nav) => (
          <{{EntityPascal}}List
            list={list}
            activeRowId={nav.selectedId}
            onRowClick={(row) => nav.showDetail(String(row.{{rowIdField}}))}
            actions={[
              { type: "view", label: words.view, onClick: (row) => nav.showDetail(String(row.{{rowIdField}})) },
{{#if hasUpdate}}
              ...(canEdit ? [{ type: "edit" as const, label: words.edit, disabled: blocks.editDisabled, onClick: (row: {{EntityPascal}}Row) => nav.showEdit(String(row.{{rowIdField}})) }] : []),
{{/if}}
              ...(blocks.rowActions?.(nav) ?? []),
{{#if hasDelete}}
              ...(canDelete ? [{ type: "delete" as const, label: words.delete, disabled: blocks.deleteDisabled, onClick: (row: {{EntityPascal}}Row) => requestDelete({ id: String(row.{{rowIdField}}), name: nameOf(row) }) }] : []),
{{/if}}
            ]}
            {...blocks.listProps?.(nav)}
          />
        )}
        renderDetail={(id, nav) => (
          <{{EntityPascal}}Detail
            {{entity}}Id={id}
            onClose={nav.closePanel}
{{#if hasUpdate}}
            onEdit={canEdit ? () => nav.showEdit(id) : undefined}
{{/if}}
{{#if hasDelete}}
            onDelete={canDelete ? (name) => requestDelete({ id, name }) : undefined}
            onDeleted={nav.showList}
{{/if}}
            {...blocks.detailProps?.(id, nav)}
          />
        )}
{{#if hasCreate}}
        renderNew={(nav) => <{{EntityPascal}}Form onClose={nav.closePanel} onSuccess={nav.showList} onCancel={nav.showList} />}
{{/if}}
{{#if hasUpdate}}
        renderEdit={(id, nav) => (
          <{{EntityPascal}}Form {{entity}}Id={id} onClose={nav.closePanel} onSuccess={() => nav.showDetail(id)} onCancel={() => nav.showDetail(id)} />
        )}
{{/if}}
      />
{{#if hasDelete}}
      {deleteDialog}
{{/if}}
      {blocks.dialogs}
    </>
  );
}


/**
 * @simplix-generated page/clarity-crud-page
 *
 * Laid down from the console-clarity kit's `crud-page.hbs` as the whole screen: its title and the
 * description its catalog states, the figures its Meta counts, the time range where its Meta names
 * one, the list with its row actions, the record, and the new and edit panels. The screen is
 * customised here, in this file, by hand; a later template change is merged into it three ways.
 */
import { useTranslation } from "@simplix-react/i18n/react";
import { CrudPage, {{#if hasCreate}}PageAction, {{/if}}type ConsoleSearch, useDetailPresentationSetting } from "@simplix-react-ui-kits/console-clarity/page";
import { {{#if (or hasCreate hasUpdate hasDelete)}}useAllowed, {{/if}}{{#if hasDelete}}{{#if displayNameField}}useRecordContract, {{/if}}{{/if}}{{#if figureTiles}}useFigureTiles, {{/if}}useScreenWords{{#if hasDelete}}{{#if displayNameField}}, type ContractField{{/if}}{{/if}} } from "@simplix-react-ui-kits/console-clarity/entity";
{{#if figureTiles}}
import { {{#if figureTiles.status}}{{figureTiles.status.hook}}{{/if}}{{#if figureTiles.status}}{{#if figureTiles.aggregates}}, {{/if}}{{/if}}{{#if figureTiles.aggregates}}{{figureTiles.aggregates.hook}}{{/if}} } from "{{packageName}}";
{{/if}}
{{#if hasDelete}}
import { adaptOrvalDelete, useCrudDeleteWired, useInvalidateEntity } from "@simplix-react/ui";
import { {{hookDelete}} } from "{{packageName}}";
{{/if}}
{{#if accessCreate}}
import { {{accessCreate}} } from "{{packageName}}";
{{/if}}
{{#if accessUpdate}}
import { {{accessUpdate}} } from "{{packageName}}";
{{/if}}
{{#if accessDelete}}
import { {{accessDelete}} } from "{{packageName}}";
{{/if}}

import { {{EntityPascal}}Detail, {{#if hasForm}}{{EntityPascal}}Form, {{/if}}{{EntityPascal}}List, use{{EntityPascal}}List{{#if (or hasUpdate hasDelete)}}, type {{EntityPascal}}Row{{/if}} } from "../../widgets/{{entityKebab}}";
{{#if timeBuckets}}
import { readCounts, type TimeRangeCountQuery } from "@simplix-react-ui-kits/console-clarity/datetime";
import { {{timeBuckets.fetch}} } from "{{packageName}}";
{{/if}}

interface {{EntityPascal}}CrudPageProps {
  readonly search: ConsoleSearch;
  readonly onNavigate: (search: ConsoleSearch) => void;
}

/** {{EntityPascal}}: the list, and the record it opens. */
{{#if hasDelete}}
{{#if displayNameField}}
/** The fields the record is named by, in order, each drawn by its kind. */
const NAME_FIELDS: readonly ContractField[] = [
{{#each nameContractFields}}
  { name: "{{this.name}}", kind: "{{this.contractKind}}"{{#if this.money}}, currency: "{{this.money.currency}}", scale: {{this.money.scale}}{{/if}}{{#if this.enumTypeName}}, enumName: "{{this.enumTypeName}}"{{/if}}{{#if this.nameField}}, nameField: "{{this.nameField}}"{{/if}}{{#if this.isCode}}, code: true{{/if}} },
{{/each}}
];

{{/if}}
{{/if}}
export function {{EntityPascal}}CrudPage({ search, onNavigate }: {{EntityPascal}}CrudPageProps) {
  const words = useScreenWords("{{entity}}");
  // The line under the title is the screen's own, from its catalog; an empty value draws none.
  const { t } = useTranslation("{{moduleNamespace}}/widgets");
  // A key the catalog holds empty comes back as the key itself, and draws no line either.
  const line = t("screen.{{entity}}.description");
  const description = line && line !== "screen.{{entity}}.description" ? line : undefined;
  const list = use{{EntityPascal}}List();
  const presentation = useDetailPresentationSetting();
{{#if figureTiles}}
  // The figures the entity's SimpliX Meta says it counts and sums, drawn as the page's figure row.
  const figures = useFigureTiles("{{entity}}", {
{{#if figureTiles.status}}
    status: { query: {{figureTiles.status.hook}}({ field: "{{figureTiles.status.field}}" }), field: "{{figureTiles.status.field}}", enumName: "{{figureTiles.status.enumName}}", values: [{{#each figureTiles.status.options}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}] },
{{/if}}
{{#if figureTiles.aggregates}}
    aggregates: {
      // The sums are read over the rows the list is showing: its filters, search text and forced scope.
      query: {{figureTiles.aggregates.hook}}(list.requestParams as Parameters<typeof {{figureTiles.aggregates.hook}}>[0]),
      figures: [
{{#each figureTiles.aggregates.figures}}
        { field: { name: "{{this.field}}", kind: "{{this.kind}}"{{#if this.money}}, currency: "{{this.money.currency}}", scale: {{this.money.scale}}{{/if}} }, op: "{{this.op}}"{{#if this.isRowCount}}, rowCount: true{{/if}} },
{{/each}}
      ],
    },
{{/if}}
    rowsLabel: words.plural,
  });
{{/if}}
{{#if (or hasCreate hasUpdate hasDelete)}}
  // Every control is gated on the rule its endpoint states, so none leads to a call the server refuses.
{{/if}}
{{#if hasCreate}}
  const canCreate = useAllowed({{#if accessCreate}}{{accessCreate}}{{else}}undefined{{/if}});
{{/if}}
{{#if hasUpdate}}
  const canEdit = useAllowed({{#if accessUpdate}}{{accessUpdate}}{{else}}undefined{{/if}});
{{/if}}
{{#if hasDelete}}
  const canDelete = useAllowed({{#if accessDelete}}{{accessDelete}}{{else}}undefined{{/if}});
{{/if}}
{{#if hasDelete}}
  const invalidate = useInvalidateEntity("{{entityPath}}");
  const { requestDelete, deleteDialog } = useCrudDeleteWired({
    deleteMutation: adaptOrvalDelete({{hookDelete}}(), "{{#if deletePathParam}}{{deletePathParam}}{{else}}{{rowIdField}}{{/if}}", { onSettled: invalidate }),
    labels: {
      title: () => words.deleteTitle,
      description: (target) => words.deleteDescription(target.name),
      cancel: words.cancel,
      delete: words.delete,
      deleting: words.deleting,
    },
    onDeleted: () => onNavigate({}),
  });
{{#if displayNameField}}
  // The record's name is every field its entity declares for it, each drawn by its kind, joined in order.
  const contract = useRecordContract("{{entity}}");
  const nameOf = (row: object) => contract.recordName(NAME_FIELDS, row as Readonly<Record<string, unknown>>);
{{else}}
  const nameOf = (row: { readonly {{rowIdField}}?: unknown }) => String(row.{{rowIdField}} ?? "");
{{/if}}
{{/if}}
{{#if timeBuckets}}
  // The entity's Meta names the field its rows are read by in time, so the page offers the time
  // range over it, counted per slice by the list's own counts read.
  const timeRange = {
    field: "{{timeBuckets.field}}",
    counts: (query: TimeRangeCountQuery) => readCounts({{timeBuckets.fetch}}({ ...query.conditions, from: query.from, to: query.to, buckets: query.buckets } as Parameters<typeof {{timeBuckets.fetch}}>[0])),
    filters: list.filters,
  };
{{/if}}

  return (
    <>
      <CrudPage
        spec={{ldb}}
          title: words.plural,
          description,
{{#if figureTiles}}
          tiles: figures.tiles,
          tilesLoading: figures.loading,
{{/if}}
{{#if hasCreate}}
          actions: canCreate ? <PageAction kind="add" label={words.add} onClick={() => onNavigate({ ...search, mode: "new", id: undefined })} /> : undefined,
{{/if}}
{{#if timeBuckets}}
          timeRange,
{{/if}}
        {{rdb}}
        search={search}
        onNavigate={onNavigate}
        {...presentation}
        // The figures (`spec.tiles`) narrow the list through its own filter state.
        tileFilters={list.filters}
        renderList={(nav) => (
          <{{EntityPascal}}List
            list={list}
            activeRowId={nav.selectedId}
            onRowClick={(row) => nav.showDetail(String(row.{{rowIdField}}))}
            actions={[
              { type: "view", label: words.view, onClick: (row) => nav.showDetail(String(row.{{rowIdField}})) },
{{#if hasUpdate}}
              ...(canEdit ? [{ type: "edit" as const, label: words.edit, onClick: (row: {{EntityPascal}}Row) => nav.showEdit(String(row.{{rowIdField}})) }] : []),
{{/if}}
{{#if hasDelete}}
              ...(canDelete ? [{ type: "delete" as const, label: words.delete, onClick: (row: {{EntityPascal}}Row) => requestDelete({ id: String(row.{{rowIdField}}), name: nameOf(row) }) }] : []),
{{/if}}
            ]}
          />
        )}
        renderDetail={(id, nav) => (
          <{{EntityPascal}}Detail
            {{entity}}Id={id}
            onClose={nav.closePanel}
{{#if hasUpdate}}
            onEdit={canEdit ? () => nav.showEdit(id) : undefined}
{{/if}}
{{#if hasDelete}}
            onDelete={canDelete ? (name) => requestDelete({ id, name }) : undefined}
            onDeleted={nav.showList}
{{/if}}
          />
        )}
{{#if hasCreate}}
        renderNew={(nav) => <{{EntityPascal}}Form onClose={nav.closePanel} onSuccess={nav.showList} onCancel={nav.showList} />}
{{/if}}
{{#if hasUpdate}}
        renderEdit={(id, nav) => (
          <{{EntityPascal}}Form {{entity}}Id={id} onClose={nav.closePanel} onSuccess={() => nav.showDetail(id)} onCancel={() => nav.showDetail(id)} />
        )}
{{/if}}
      />
{{#if hasDelete}}
      {deleteDialog}
{{/if}}
    </>
  );
}


/**
 * @simplix-generated page/clarity-app-shell-top-bar
 *
 * The app's window, laid down once from the console-clarity kit's `app-shell.top-bar.hbs` and owned
 * by the app from then on: a top bar and the routed screen under it, with no menu column and no
 * status strip, for an app whose readers reach a handful of destinations from the bar itself. The
 * bar, the destinations, what wraps the routed screens and the pages drawn in place of the window
 * for a refused self read are this file's own, in `useShellParts` below, and are customised here;
 * the screens reached without a session wear `AuthLayout`.
 */
import { Outlet, useRouterState } from "@tanstack/react-router";
import type { ReactNode } from "react";
import { useTranslation } from "@simplix-react/i18n/react";
import { PageHeaderProvider } from "@simplix-react/ui";
import { PeekHost } from "@simplix-react-ui-kits/console-clarity/peek";
import { NoticeRegistryProvider } from "@simplix-react-ui-kits/console-clarity/notice";
import { AuthLayout, ConsoleBandTopBar, ConsoleTopBarWindow, DarkModeToggle, LocalePicker, useShellRefusalScreen, type ShellRefusalPages } from "@simplix-react-ui-kits/console-clarity/shell";

export interface ShellParts {
  /** The band across the top of the window: the mark, the destinations and the controls. */
  readonly topBar: ReactNode;
  /** The routes drawn without the window (sign-in and the pages around it). */
  readonly isOutsideTheShell: (route: string) => boolean;
  /** Providers the routed screen needs inside the window. */
  readonly wrap: (screen: ReactNode) => ReactNode;
  /**
   * The page drawn in place of the whole shell while the server refuses the signed-in identity's own
   * read, by the error code its envelope carries. Absent, no refusal changes the shell.
   */
  readonly refusalPages?: ShellRefusalPages;
}

/** The shell's parts for the route on screen, which the bar reads to mark where the reader stands. */
export function useShellParts(_route: string): ShellParts {
  const { t } = useTranslation("{{namespace}}");
  return {
    topBar: (
      <ConsoleBandTopBar mark={t("shell.title")}>
        <LocalePicker />
        <DarkModeToggle />
      </ConsoleBandTopBar>
    ),
    isOutsideTheShell: () => false,
    wrap: (screen) => screen,
  };
}

/** Picks the shell a screen wears: the sign-in shell before a session, the top-bar window after it. */
export function RootLayout() {
  // What the outlet renders, not where the router is heading: the previous route stays on screen
  // until the next one loads.
  const route = useRouterState({ select: (s) => s.matches[s.matches.length - 1]?.pathname ?? s.location.pathname });
  const parts = useShellParts(route);
  // A refusal the parts name a page for replaces the whole shell, sign-in included: every read
  // behind it is refused the same way.
  const refusal = useShellRefusalScreen(parts.refusalPages);
  if (refusal) return refusal;
  if (parts.isOutsideTheShell(route)) return <AuthLayout />;
  return (
    <PeekHost>
      <PageHeaderProvider>
        <NoticeRegistryProvider>
          <ConsoleTopBarWindow topBar={parts.topBar}>{parts.wrap(<Outlet />)}</ConsoleTopBarWindow>
        </NoticeRegistryProvider>
      </PageHeaderProvider>
    </PeekHost>
  );
}

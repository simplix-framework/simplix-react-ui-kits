/**
 * @simplix-generated page/clarity-static-page
 *
 * A page of text and settings with no list, laid down from the console-clarity kit's
 * `static-page.hbs` as the whole screen: its title, the description its catalog states, and its
 * tabs or one body. What the page says is written here, in this file; a later template change is
 * merged into it three ways.
 */
import { useTranslation } from "@simplix-react/i18n/react";
import { ConsolePage, type ConsoleSearch } from "@simplix-react-ui-kits/console-clarity/page";


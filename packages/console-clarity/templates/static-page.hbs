}

/** {{NamePascal}}: one page of content. */
export function {{NamePascal}}Page({ search, onNavigate }: {{NamePascal}}PageProps = {}) {
  const { t } = useTranslation("{{namespace}}");
  // A key the catalog holds empty comes back as the key itself, and draws no line either.
  const line = t("{{nameCamel}}.description");

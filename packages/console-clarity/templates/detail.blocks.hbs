 */
export type DetailBlocks = CrudDetailBlocks;

export function useDetailBlocks<T>(_detail: { readonly record: T | undefined; readonly props: {{EntityPascal}}DetailProps; readonly fields: readonly ContractField[] }): DetailBlocks {
  return {};

/** Sample rows, one value per field by its contract kind. */
const ROWS: readonly Row[] = {{{fixtureRowsJson}}};

const idOf = (row: Row) => String(row.{{rowIdField}});

interface Args {
  /** The record standing open when the story starts. */
  readonly open?: string;
}

function Screen({ open }: Args) {
  const words = useScreenWords("{{entity}}");
  const records = useMockRecords(ROWS, idOf);
  const [search, setSearch] = useState<ConsoleSearch>(open ? { id: open } : {});
  const contract = useRecordContract("{{entity}}");
  const columns = contract.columns<Row>(COLUMN_FIELDS);
  return (
    <CrudPage
      spec={{ldb}} title: words.plural {{rdb}}
      search={search}
      onNavigate={setSearch}
      renderList={(nav) => (
        <RecordList<Row>
          rows={records.rows}
          rowId={idOf}
          columns={columns}
          activeRowId={nav.selectedId}
          onRowClick={(row) => nav.showDetail(idOf(row))}
        />
      )}
      renderDetail={(id, nav) => {
        const row = records.find(id);
        return (
          <RecordDetail
            title={row ? String(row.{{#if displayNameField}}{{displayNameField}}{{else}}{{rowIdField}}{{/if}} ?? id) : id}
            sections={[{ key: "overview", fields: row ? DETAIL_FIELDS.map((field) => contract.detailField(field, row)) : [] }]}
            onClose={nav.closePanel}
          />
        );
      }}
    />
  );
}


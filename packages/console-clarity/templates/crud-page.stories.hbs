/** Sample rows, one value per field by its contract kind. */
const ROWS: readonly Row[] = {{{fixtureRowsJson}}};

const idOf = (row: Row) => String(row.{{rowIdField}});

interface Args {
  /** The record standing open when the story starts. */
  readonly open?: string;
}

function Screen({ open }: Args) {
  const words = useScreenWords("{{entity}}");
  // The same setting the generated page reads, so the frame draws the presentation switch the screen draws.
  const presentation = useDetailPresentationSetting();
  const records = useMockRecords(ROWS, idOf);
  const [search, setSearch] = useState<ConsoleSearch>(open ? { id: open } : {});
  const contract = useRecordContract("{{entity}}");
  const columns = contract.columns<Row>(COLUMN_FIELDS);
  return (
    <CrudPage
      spec={{ldb}} title: words.plural, description: words.description{{#if hasCreate}}, actions: <PageAction kind="add" label={words.add} onClick={() => setSearch({ mode: "new" })} />{{/if}} {{rdb}}
      search={search}
      onNavigate={setSearch}
      {...presentation}
      renderList={(nav) => (
        <RecordList<Row>
          rows={records.rows}
          rowId={idOf}
          columns={columns}
          filters={contract.filters<Row>(FILTERS)}
          empty={ { {{#if hasCreate}}title: words.emptyTitle, description: words.emptyDescription{{else}}title: words.emptyTitleRecorded, description: words.emptyDescriptionRecorded{{/if}} } }
          // The generated page's row actions, so the frame draws the column the screen draws.
          actions={[
            { type: "view", label: words.view, onClick: (row) => nav.showDetail(idOf(row)) },
{{#if hasUpdate}}
            { type: "edit", label: words.edit, onClick: (row) => nav.showEdit(idOf(row)) },
{{/if}}
{{#if hasDelete}}
            { type: "delete", label: words.delete, onClick: (row) => records.remove(idOf(row)) },
{{/if}}
          ]}
{{#if hookOrder}}
{{#if orderField}}
          // The contract has a reorder, so the frame draws the drag the screen offers.
          reorder={ { orderField: "{{orderField}}", idField: "{{rowIdField}}", onReorder: (updates) => updates.forEach((one) => records.update(String(one.{{rowIdField}}), { {{orderField}}: one.{{orderField}} })) } }
{{/if}}
{{/if}}
          activeRowId={nav.selectedId}
          onRowClick={(row) => nav.showDetail(idOf(row))}
{{#unless hasKeywordSearch}}
          // The route declares no keyword field, so the screen draws no search box either.
          features={ { search: false } }
{{/unless}}
        />
      )}
      renderDetail={(id, nav) => {
        const row = records.find(id);
        return (
          <RecordDetail
            title={row ? ({{#if displayNameField}}contract.recordName(NAME_FIELDS, row){{else}}String(row.{{rowIdField}} ?? ""){{/if}} || id) : id}
            sections={[{ key: "overview", fields: row ? DETAIL_FIELDS.map((field) => contract.detailField(field, row)) : [] }]}
{{#if (or hasUpdate hasDelete)}}
            // The generated detail's footer verbs, so the frame draws the footer the screen draws.
            actions={[
{{#if hasDelete}}
              { label: words.delete, kind: "danger", onClick: () => { records.remove(id); nav.closePanel(); } },
{{/if}}
{{#if hasUpdate}}
              { label: words.edit, onClick: () => nav.showEdit(id) },
{{/if}}
            ]}
{{/if}}
            onClose={nav.closePanel}
          />
        );
      }}
    />
  );
}


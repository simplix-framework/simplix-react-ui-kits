/**
 * @simplix-generated blocks/form.blocks
 * What the {{entity}} form departs in from the generated one: its sections, its notices and the
 * request it sends.
 * Generated from the kit's form.blocks template and tracked: edit inside its keys, and a template change is merged into it three ways on regeneration.
 */
import type { ContractField, ContractOverrides, CrudFormBlocks, RecordFormField } from "@simplix-react-ui-kits/console-clarity/entity";

/**
 * The keys a form may state, and what each one does, are the kit's `CrudFormBlocks`. The generated
 * form imports this file, so import only types from `./form`; the field table the contract lets
 * the form write arrives as `fields`.
 */
export type FormBlocks = CrudFormBlocks;

export function useFormBlocks<T>(_form: { readonly record: T | undefined; readonly editing: boolean; readonly generated: readonly RecordFormField[]; readonly fields: readonly ContractField[] }): FormBlocks {
  return {};
}

/** Tones and the reference pickers this form edits with; a reference with no picker is edited as text. */
export function useFormContract(): ContractOverrides {
  return {};
}

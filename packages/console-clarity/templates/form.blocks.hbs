/**
 * What the {{entity}} form departs in from the generated one: its sections, its notices and the
 * request it sends. Written by hand and never regenerated.
 */
import type { ContractOverrides, RecordFormField, RecordFormSection, RecordNotice } from "@simplix-react-ui-kits/console-clarity/entity";

export interface FormBlocks {
  readonly title?: string;
  readonly sections?: readonly RecordFormSection[];
  readonly notices?: readonly RecordNotice[];
  readonly submitLabel?: string;
  /** The request from the form's values; on an edit the loaded record goes underneath it. */
  readonly toRequest?: (values: Readonly<Record<string, unknown>>, record?: Readonly<Record<string, unknown>>) => Record<string, unknown>;
}

export function useFormBlocks<T>(_form: { readonly record: T | undefined; readonly editing: boolean; readonly generated: readonly RecordFormField[] }): FormBlocks {
  return {};
}

/** Tones and the reference pickers this form edits with; a reference with no picker is edited as text. */
export function useFormContract(): ContractOverrides {
  return {};
}

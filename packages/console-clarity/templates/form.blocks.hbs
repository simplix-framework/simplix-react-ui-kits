/**
 * What the {{entity}} form departs in from the generated one: its sections, its notices and the
 * request it sends. Written by hand and never regenerated.
 */
import type { ContractOverrides, CrudFormBlocks, RecordFormField } from "@simplix-react-ui-kits/console-clarity/entity";

/** The keys a form may state, and what each one does, are the kit's `CrudFormBlocks`. */
export type FormBlocks = CrudFormBlocks;

export function useFormBlocks<T>(_form: { readonly record: T | undefined; readonly editing: boolean; readonly generated: readonly RecordFormField[] }): FormBlocks {
  return {};
}

/** Tones and the reference pickers this form edits with; a reference with no picker is edited as text. */
export function useFormContract(): ContractOverrides {
  return {};
}

{
  "name": "@simplix-react-ui-kits/site-clarity",
  "version": "0.0.1",
  "private": true,
  "description": "Web site UI kit, clarity design: the site parts drawn with hairline borders, one accent and hierarchy from type",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./action": {
      "source": "./src/action/index.ts",
      "types": "./src/action/index.ts",
      "import": "./dist/action/index.js"
    },
    "./help": {
      "source": "./src/help/index.ts",
      "types": "./src/help/index.ts",
      "import": "./dist/help/index.js"
    },
    "./install": {
      "source": "./src/install/index.ts",
      "types": "./src/install/index.ts",
      "import": "./dist/install/index.js"
    },
    "./link": {
      "source": "./src/link/index.ts",
      "types": "./src/link/index.ts",
      "import": "./dist/link/index.js"
    },
    "./marketing": {
      "source": "./src/marketing/index.ts",
      "types": "./src/marketing/index.ts",
      "import": "./dist/marketing/index.js"
    },
    "./page": {
      "source": "./src/page/index.ts",
      "types": "./src/page/index.ts",
      "import": "./dist/page/index.js"
    },
    "./pricing": {
      "source": "./src/pricing/index.ts",
      "types": "./src/pricing/index.ts",
      "import": "./dist/pricing/index.js"
    },
    "./shell": {
      "source": "./src/shell/index.ts",
      "types": "./src/shell/index.ts",
      "import": "./dist/shell/index.js"
    },
    "./styles/*": "./src/styles/*",
    "./regions.json": "./regions.json",
    "./measure.json": "./measure.json",
    "./measure/*": "./measure/*",
    "./scripts/site-regions-rendered.mjs": "./scripts/site-regions-rendered.mjs"
  },
  "files": [
    "dist",
    "src",
    "templates",
    "regions.json",
    "measure.json",
    "measure",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --no-clean --no-dts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-site-regions.mjs && oxlint src scripts && simplix-design-literals src",
    "test": "node scripts/check-site-regions.mjs --selftest && node scripts/site-regions-rendered.mjs --selftest && node scripts/site-demo.mjs --selftest && vitest run",
    "design:css": "simplix-design-css --root ../site-core --out ../site-clarity/src/styles/designs/clarity.css",
    "design:check": "simplix-design-css --root ../site-core --out ../site-clarity/src/styles/designs/clarity.css --check && node scripts/check-site-regions.mjs",
    "clean": "rm -rf dist .turbo",
    "rendered": "node scripts/site-demo.mjs --measure"
  },
  "dependencies": {
    "@simplix-react-ui-kits/site-core": "workspace:*",
    "simplix-react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@simplix-react-ui-kits/console-core": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "simplix": {
    "templates": "templates"
  }
}

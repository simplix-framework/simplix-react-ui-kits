{
  "name": "@simplix-react-ui-kits/site-clarity",
  "version": "0.0.1",
  "private": true,
  "description": "Web site UI kit, clarity design: the site parts drawn with hairline borders, one accent and hierarchy from type",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./account": {
      "source": "./src/account/index.ts",
      "types": "./src/account/index.ts",
      "import": "./dist/account/index.js"
    },
    "./action": {
      "source": "./src/action/index.ts",
      "types": "./src/action/index.ts",
      "import": "./dist/action/index.js"
    },
    "./auth": {
      "source": "./src/auth/index.ts",
      "types": "./src/auth/index.ts",
      "import": "./dist/auth/index.js"
    },
    "./checkout": {
      "source": "./src/checkout/index.ts",
      "types": "./src/checkout/index.ts",
      "import": "./dist/checkout/index.js"
    },
    "./form": {
      "source": "./src/form/index.ts",
      "types": "./src/form/index.ts",
      "import": "./dist/form/index.js"
    },
    "./help": {
      "source": "./src/help/index.ts",
      "types": "./src/help/index.ts",
      "import": "./dist/help/index.js"
    },
    "./install": {
      "source": "./src/install/index.ts",
      "types": "./src/install/index.ts",
      "import": "./dist/install/index.js"
    },
    "./legal": {
      "source": "./src/legal/index.ts",
      "types": "./src/legal/index.ts",
      "import": "./dist/legal/index.js"
    },
    "./link": {
      "source": "./src/link/index.ts",
      "types": "./src/link/index.ts",
      "import": "./dist/link/index.js"
    },
    "./marketing": {
      "source": "./src/marketing/index.ts",
      "types": "./src/marketing/index.ts",
      "import": "./dist/marketing/index.js"
    },
    "./page": {
      "source": "./src/page/index.ts",
      "types": "./src/page/index.ts",
      "import": "./dist/page/index.js"
    },
    "./pricing": {
      "source": "./src/pricing/index.ts",
      "types": "./src/pricing/index.ts",
      "import": "./dist/pricing/index.js"
    },
    "./shell": {
      "source": "./src/shell/index.ts",
      "types": "./src/shell/index.ts",
      "import": "./dist/shell/index.js"
    },
    "./styles/*": "./src/styles/*",
    "./measure.json": "./measure.json",
    "./measure/*": "./measure/*"
  },
  "files": [
    "dist",
    "src",
    "measure.json",
    "measure",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --no-clean --no-dts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "lint": "oxlint src scripts && simplix-design-literals src",
    "test": "node scripts/site-demo.mjs --selftest && vitest run && pnpm test:templates",
    "clean": "rm -rf dist .turbo",
    "rendered": "node scripts/site-demo.mjs --measure",
    "test:templates": "node ../../testing/template-harness/harness.mjs ."
  },
  "dependencies": {
    "@simplix-react-ui-kits/site-core": "workspace:*",
    "simplix-react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@simplix-react-ui-kits/console-core": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "simplix": {
    "extends": "@simplix-react-ui-kits/site-core",
    "id": "site"
  }
}

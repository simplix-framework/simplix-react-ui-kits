  "types": {
    "pricing": {
      "status": "ready",
      "root": "[data-page]",
      "regions": [
        "bar",
        "pageHead",
        "switches",
        "plans",
        "offers",
        "priceTable",
        "questions",
        "footer"
      ],
      "required": [
        "bar",
        "pageHead",
        "plans",
        "footer"
      ],
      "$comment": "The offers, the price table and the questions follow the plans; a page leaves out a region its catalogue has nothing for, never reorders one."
    },
    "marketing": {
      "status": "ready",
      "root": "[data-page]",
      "regions": [
        "bar",
        "hero",
        "compare",
        "steps",
        "footer"
      ],
      "required": [
        "bar",
        "hero",
        "footer"
      ],
      "$comment": "A product introduction: the bar continues the dark hero band, then the page column (SitePage rhythm=open) holds a split section of samples and the numbered steps with their promises."
    },
    "install": {
      "status": "ready",
      "root": "[data-page]",
      "regions": [
        "bar",
        "pageHead",
        "notice",
        "check",
        "downloads",
        "installSteps",
        "video",
        "troubleshooting",
        "symptoms",
        "caption",
        "footer"
      ],
      "required": [
        "bar",
        "pageHead",
        "footer"
      ],
      "$comment": "The download guide (the check of this computer, or on a phone the notice to open the page on the computer, the downloads, the steps with their sketches, the video and the way to troubleshooting) and the troubleshooting page (the symptoms and the line under them) share the type: a page draws the regions its view has, in this order."
    },
    "help": {
      "status": "ready",
      "root": "[data-page]",
      "regions": [
        "bar",
        "search",
        "categories",
        "articles",
        "contact",
        "footer"
      ],
      "required": [
        "bar",
        "search",
        "footer"
      ],
      "$comment": "The help centre: the search band (status, h1, lede, searches to try, the search and its matches), then the categories, and the most read articles beside the way to ask support (closed, the form, or sent). An article is the article type."
    },
    "legal": {
      "status": "ready",
      "root": "[data-page]",
      "regions": [
        "bar",
        "breadcrumb",
        "docHead",
        "contents",
        "doc",
        "footer"
      ],
      "required": [
        "bar",
        "docHead",
        "doc",
        "footer"
      ],
      "$comment": "A legal text on DocLayout: the trail, the head (title with the draft badge, the version picker and Save as PDF, a notice about the version or the list of changes, the disclaimer), the contents rail with a dot on each changed article, then the articles: a numbered heading, the plain summary and the clauses, with additions and removals marked in the comparison, and cards of labelled values on the business page."
    },
    "account": {
      "status": "ready",
      "root": "[data-page]",
      "regions": [
        "bar",
        "sectionNav",
        "accountSection",
        "footer"
      ],
      "required": [
        "bar",
        "sectionNav",
        "accountSection",
        "footer"
      ],
      "$comment": "My account: the section list beside one section (stacked below the medium tier). A state that holds over every section (a failed renewal) is a NoticeBanner at the top of the section; there is no page head, the section's h2 names it."
    },
    "checkout": {
      "status": "ready",
      "root": "[data-page]",
      "regions": [
        "bar",
        "stepper",
        "checkout",
        "done",
        "footer"
      ],
      "required": [
        "bar",
        "footer"
      ],
      "$comment": "A purchase: the steps and their line, then our side beside the provider's frame; the page after payment draws the done column instead."
    },
    "auth": {
      "status": "ready",
      "root": "[data-page]",
      "regions": [
        "authCard"
      ],
      "required": [
        "authCard"
      ],
      "$comment": "The sign-in server's pages (the Keycloak theme): no site bar or footer, one card on the server's own ground, light or dark."
    },
    "article": {
      "status": "ready",
      "root": "[data-page]",
      "regions": [
        "bar",
        "breadcrumb",
        "docHead",
        "contents",
        "doc",
        "footer"
      ],
      "required": [
        "bar",
        "docHead",
        "doc",
        "footer"
      ],
      "$comment": "A help article or guide on DocLayout: the trail, the head (title, the article meta, where it applies, the lead), then the contents rail (with progress or the way to ask) beside the document (quick checks, numbered steps with figures, tables, tips and the tried toggle, a closing section, feedback and related articles)."
    }
  }
}

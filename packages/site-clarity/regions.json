{
  "$comment": "The site page region contract. Per page type: the regions in drawing order, the part that fills each and the prop that feeds it (slot), the DOM marks (data-slot) that place an element in it, the named parts inside it a rendered check measures, the control kinds it may hold, the parts whose width the layout decides (widths: \"root\" or a part name; a rendered compare holds those widths to 1px and leaves text-driven ones alone) and whether the region draws a card (carded: a root or part rounded with --site-radius-xl, which the site-demo selftest plants and must find). A type is `ready` when the kit draws every region it lists, or `planned` with the reason it is not yet. scripts/check-site-regions.mjs holds the contract to site-core's declared slots; scripts/site-regions-rendered.mjs reads a painted page against it.",
  "version": 1,
  "frame": {
    "$comment": "The window around every page and the column the page's regions stand in; measured on every page type, never a region of its own.",
    "window": "site-window",
    "main": "site-main",
    "column": "site-page"
  },
  "regions": {
    "bar": {
      "part": "SiteBar",
      "slot": "SiteWindow.bar",
      "marks": [
        "site-bar"
      ],
      "controls": [
        "site-bar-brand",
        "site-bar-link",
        "site-action",
        "site-bar-account",
        "site-bar-more",
        "site-bar-menu-item"
      ],
      "parts": {
        "brand": "site-bar-brand",
        "link": "site-bar-link[data-current=false]",
        "current": "site-bar-link[data-current=true]",
        "action": "site-action",
        "account": "site-bar-account",
        "avatar": "site-avatar"
      },
      "widths": [
        "root"
      ]
    },
    "hero": {
      "part": "HeroBand",
      "slot": "SiteWindow children",
      "marks": [
        "site-hero"
      ],
      "controls": [
        "site-action",
        "site-switch-option",
        "site-play-toggle"
      ],
      "$comment": "The hero holds its own band, so its root measures the band ground; the player card in its media slot is measured as named parts.",
      "parts": {
        "inner": "site-hero-inner",
        "copy": "site-hero-copy",
        "eyebrow": "site-hero-eyebrow",
        "title": "site-hero-title",
        "accent": "site-hero-accent",
        "lede": "site-hero-lede",
        "actions": "site-hero-actions",
        "primary": "site-action[data-tone=primary]",
        "secondary": "site-action[data-tone=secondary]",
        "facts": "site-hero-facts",
        "player": "site-player",
        "track": "site-switch",
        "option": "site-switch-option[data-checked=false]",
        "chosen": "site-switch-option[data-checked=true]",
        "text": "site-read-along",
        "word": "site-read-word",
        "spoken": "site-read-word[data-state=spoken]",
        "upcoming": "site-read-word[data-state=upcoming]",
        "wave": "site-wave",
        "barRest": "site-wave-bar[data-played=false]",
        "barPlayed": "site-wave-bar[data-played=true]",
        "toggle": "site-play-toggle",
        "caption": "site-player-caption"
      },
      "widths": [
        "root",
        "inner",
        "copy",
        "player",
        "track",
        "text",
        "wave"
      ]
    },
    "compare": {
      "part": "SplitSection",
      "slot": "SitePage children",
      "marks": [
        "site-split"
      ],
      "controls": [
        "site-sample"
      ],
      "parts": {
        "head": "site-split-head",
        "heading": "site-display-heading",
        "lede": "site-split-lede",
        "list": "site-sample-list",
        "sample": "site-sample[data-playing=false]",
        "playing": "site-sample[data-playing=true]",
        "disc": "site-sample-disc[data-playing=false]",
        "playingDisc": "site-sample-disc[data-playing=true]",
        "name": "site-sample-name",
        "meta": "site-sample-meta",
        "line": "site-sample-line",
        "text": "site-sample-text",
        "wave": "site-wave",
        "bar": "site-wave-bar[data-played=false]",
        "barPlayed": "site-wave-bar[data-played=true]"
      },
      "widths": [
        "root",
        "head",
        "list",
        "sample",
        "playing",
        "line",
        "wave"
      ],
      "carded": true
    },
    "steps": {
      "part": "NumberedSteps",
      "slot": "SitePage children",
      "marks": [
        "site-steps"
      ],
      "controls": [],
      "parts": {
        "heading": "site-display-heading",
        "list": "site-steps-list",
        "step": "site-step",
        "number": "site-step-number",
        "art": "site-bars",
        "bar": "site-bars-bar[data-tone=soft]",
        "strongBar": "site-bars-bar[data-tone=strong]",
        "wave": "site-wave",
        "title": "site-step-title",
        "body": "site-step-body",
        "notes": "site-note-list",
        "note": "site-note",
        "mark": "site-note-mark"
      },
      "widths": [
        "root",
        "list",
        "step",
        "art",
        "wave"
      ],
      "carded": true
    },
    "breadcrumb": {
      "part": "SiteBreadcrumb",
      "slot": "SitePage children",
      "marks": [
        "site-breadcrumb"
      ],
      "controls": [
        "site-breadcrumb-link"
      ],
      "parts": {
        "step": "site-breadcrumb-link",
        "current": "site-breadcrumb-item[data-current=true]"
      },
      "widths": []
    },
    "pageHead": {
      "part": "SitePageHead",
      "slot": "SitePage children",
      "marks": [
        "site-page-head"
      ],
      "controls": [],
      "parts": {
        "eyebrow": "site-page-eyebrow",
        "title": "site-page-title",
        "lede": "site-page-lede"
      },
      "widths": [
        "root"
      ]
    },
    "switches": {
      "part": "SwitchRow",
      "slot": "SitePage children",
      "marks": [
        "site-switch-row"
      ],
      "controls": [
        "site-switch-option"
      ],
      "parts": {
        "track": "site-switch",
        "option": "site-switch-option[data-checked=false]",
        "chosen": "site-switch-option[data-checked=true]"
      },
      "widths": [
        "root"
      ]
    },
    "plans": {
      "part": "PlanGrid",
      "slot": "SitePage children",
      "marks": [
        "site-plan-grid"
      ],
      "controls": [
        "site-action"
      ],
      "parts": {
        "card": "site-plan-card[data-highlight=false]",
        "highlighted": "site-plan-card[data-highlight=true]",
        "badge": "site-plan-card-badge",
        "name": "site-plan-card-name",
        "price": "site-plan-card-price",
        "unit": "site-plan-card-unit",
        "note": "site-plan-card-note",
        "pitch": "site-plan-card-pitch",
        "features": "site-feature-list",
        "feature": "site-feature",
        "mark": "site-feature-mark",
        "primary": "site-action[data-tone=primary]",
        "secondary": "site-action[data-tone=secondary]",
        "quiet": "site-action[data-tone=quiet]",
        "current": "site-action:disabled"
      },
      "widths": [
        "root",
        "card",
        "highlighted"
      ],
      "carded": true
    },
    "offers": {
      "part": "OfferRow",
      "slot": "SitePage children",
      "marks": [
        "site-offer-row"
      ],
      "controls": [
        "site-action"
      ],
      "maxControls": 1,
      "parts": {
        "title": "site-offer-row-title",
        "about": "site-offer-row-about",
        "action": "site-action:enabled",
        "note": "site-offer-row-note",
        "disabled": "site-action:disabled"
      },
      "widths": [
        "root"
      ],
      "carded": true
    },
    "priceTable": {
      "part": "PriceTable",
      "slot": "SitePage children",
      "marks": [
        "site-price-table"
      ],
      "controls": [],
      "parts": {
        "caption": "site-price-table-caption",
        "head": "site-price-table-head",
        "column": "site-price-table-column",
        "row": "site-price-table-row",
        "rowHead": "site-price-table-row-head",
        "cell": "site-price-table-cell"
      },
      "widths": [
        "root"
      ],
      "carded": true
    },
    "questions": {
      "part": "QuestionList",
      "slot": "SiteSection children",
      "marks": [
        "site-question-list"
      ],
      "within": "site-section",
      "controls": [],
      "parts": {
        "heading": "site-section-heading",
        "list": "site-question-list",
        "ask": "site-question-ask",
        "answer": "site-question-answer"
      },
      "widths": [
        "root",
        "list"
      ]
    },
    "footer": {
      "part": "SiteFooter",
      "slot": "SiteWindow.footer",
      "marks": [
        "site-footer"
      ],
      "controls": [
        "site-footer-link",
        "*"
      ],
      "$comment": "`*` admits the product's language picker, which stands in the footer's language place and is the product's own control.",
      "parts": {
        "owner": "site-footer-owner",
        "link": "site-footer-link[data-emphasis=false]",
        "emphasis": "site-footer-link[data-emphasis=true]"
      },
      "widths": [
        "root"
      ]
    }
  },
  "types": {
    "pricing": {
      "status": "ready",
      "root": "[data-page]",
      "regions": [
        "bar",
        "pageHead",
        "switches",
        "plans",
        "offers",
        "priceTable",
        "questions",
        "footer"
      ],
      "required": [
        "bar",
        "pageHead",
        "plans",
        "footer"
      ],
      "$comment": "The offers, the price table and the questions follow the plans; a page leaves out a region its catalogue has nothing for, never reorders one."
    },
    "marketing": {
      "status": "ready",
      "root": "[data-page]",
      "regions": [
        "bar",
        "hero",
        "compare",
        "steps",
        "footer"
      ],
      "required": [
        "bar",
        "hero",
        "footer"
      ],
      "$comment": "A product introduction: the bar continues the dark hero band, then the page column (SitePage rhythm=open) holds a split section of samples and the numbered steps with their promises."
    },
    "install": {
      "status": "planned",
      "reason": "needs the install segment (CheckCard, DownloadCard, CopyBlock, VideoCard)",
      "plannedRegions": [
        "bar",
        "pageHead",
        "check",
        "downloads",
        "steps",
        "video",
        "troubleshooting",
        "footer"
      ]
    },
    "help": {
      "status": "planned",
      "reason": "needs the help segment (StatusLine, SearchHero, CategoryGrid, ArticleList, ArticleLayout, ContactForm)",
      "plannedRegions": [
        "bar",
        "status",
        "pageHead",
        "search",
        "categories",
        "articles",
        "contact",
        "footer"
      ]
    },
    "legal": {
      "status": "planned",
      "reason": "needs the legal segment (DocLayout, PlainSummary, VersionPicker, DiffText, KeyValues, LegalTable, PrintButton); the breadcrumb region is in place",
      "plannedRegions": [
        "bar",
        "breadcrumb",
        "pageHead",
        "contents",
        "articles",
        "footer"
      ]
    },
    "account": {
      "status": "planned",
      "reason": "needs the account segment (AccountLayout, SectionNav, SettingsRows, QuotaMeter, DaySeries, TableCard, ConfirmByTyping, StandingBanner)",
      "plannedRegions": [
        "bar",
        "banner",
        "sections",
        "sectionHead",
        "rows",
        "footer"
      ]
    },
    "checkout": {
      "status": "planned",
      "reason": "needs the checkout segment (Stepper, CheckoutLayout, ChoiceCards, ConsentChecklist, OrderSummary, MethodGrid, ProgressChain, DonePanel)",
      "plannedRegions": [
        "bar",
        "stepper",
        "main",
        "summary",
        "footer"
      ]
    },
    "auth": {
      "status": "planned",
      "reason": "needs the auth segment (AuthCard) the Keycloak theme draws; it has no site bar or footer",
      "plannedRegions": [
        "card",
        "providers",
        "foot"
      ]
    }
  }
}

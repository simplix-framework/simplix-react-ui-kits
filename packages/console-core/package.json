{
  "name": "@simplix-react-ui-kits/console-core",
  "version": "0.0.1",
  "private": true,
  "description": "Console UI kit parts shared by every console design: page pattern, layout, notices, shell and screen widgets, each element marked with the slot a design draws",
  "type": "module",
  "sideEffects": [
    "**/locales/**",
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./api": {
      "source": "./src/api/index.ts",
      "types": "./src/api/index.ts",
      "import": "./dist/api/index.js"
    },
    "./attachment": {
      "source": "./src/attachment/index.ts",
      "types": "./src/attachment/index.ts",
      "import": "./dist/attachment/index.js"
    },
    "./badge": {
      "source": "./src/badge/index.tsx",
      "types": "./src/badge/index.tsx",
      "import": "./dist/badge/index.js"
    },
    "./clipboard": {
      "source": "./src/clipboard/index.ts",
      "types": "./src/clipboard/index.ts",
      "import": "./dist/clipboard/index.js"
    },
    "./clipboard/fallback": {
      "source": "./src/clipboard/fallback.ts",
      "types": "./src/clipboard/fallback.ts",
      "import": "./dist/clipboard/fallback.js"
    },
    "./dashboard": {
      "source": "./src/dashboard/index.ts",
      "types": "./src/dashboard/index.ts",
      "import": "./dist/dashboard/index.js"
    },
    "./datetime": {
      "source": "./src/datetime/index.ts",
      "types": "./src/datetime/index.ts",
      "import": "./dist/datetime/index.js"
    },
    "./entity": {
      "source": "./src/entity/index.ts",
      "types": "./src/entity/index.ts",
      "import": "./dist/entity/index.js"
    },
    "./error": {
      "source": "./src/error/index.ts",
      "types": "./src/error/index.ts",
      "import": "./dist/error/index.js"
    },
    "./i18n": {
      "source": "./src/i18n/index.ts",
      "types": "./src/i18n/index.ts",
      "import": "./dist/i18n/index.js"
    },
    "./identity": {
      "source": "./src/identity/index.ts",
      "types": "./src/identity/index.ts",
      "import": "./dist/identity/index.js"
    },
    "./layout": {
      "source": "./src/layout/index.ts",
      "types": "./src/layout/index.ts",
      "import": "./dist/layout/index.js"
    },
    "./manual": {
      "source": "./src/manual/index.ts",
      "types": "./src/manual/index.ts",
      "import": "./dist/manual/index.js"
    },
    "./mock": {
      "source": "./src/mock/index.ts",
      "types": "./src/mock/index.ts",
      "import": "./dist/mock/index.js"
    },
    "./notice": {
      "source": "./src/notice/index.ts",
      "types": "./src/notice/index.ts",
      "import": "./dist/notice/index.js"
    },
    "./page": {
      "source": "./src/page/index.ts",
      "types": "./src/page/index.ts",
      "import": "./dist/page/index.js"
    },
    "./peek": {
      "source": "./src/peek/index.ts",
      "types": "./src/peek/index.ts",
      "import": "./dist/peek/index.js"
    },
    "./screen": {
      "source": "./src/screen/index.ts",
      "types": "./src/screen/index.ts",
      "import": "./dist/screen/index.js"
    },
    "./shell": {
      "source": "./src/shell/index.ts",
      "types": "./src/shell/index.ts",
      "import": "./dist/shell/index.js"
    },
    "./styles/*": "./src/styles/*",
    "./templates/*": "./templates/*",
    "./regions.json": "./regions.json",
    "./scripts/regions-rendered.mjs": "./scripts/regions-rendered.mjs",
    "./tile-columns.json": "./tile-columns.json",
    "./scripts/tile-columns-rendered.mjs": "./scripts/tile-columns-rendered.mjs",
    "./scripts/list-columns-rendered.mjs": "./scripts/list-columns-rendered.mjs"
  },
  "bin": {
    "simplix-design-literals": "scripts/check-design-literals.mjs",
    "simplix-avatar-owner": "scripts/check-avatar-owner.mjs"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "templates",
    "regions.json",
    "tile-columns.json"
  ],
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 tsup",
    "dev": "tsup --no-clean --no-dts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-regions.mjs && oxlint src && node scripts/check-avatar-owner.mjs --test && node scripts/check-avatar-owner.mjs --owner 'src/identity/initials-avatar*' src",
    "test": "node scripts/check-regions.mjs --selftest && node scripts/regions-rendered.mjs --selftest && node scripts/tile-columns-rendered.mjs --selftest && node scripts/list-columns-rendered.mjs --selftest && node scripts/focus-clip-rendered.mjs --selftest && node scripts/clip-rendered.mjs --selftest && vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo",
    "design:css": "simplix-design-css --root . --out src/styles/designs/classic.css",
    "design:check": "simplix-design-css --root . --out src/styles/designs/classic.css --check && simplix-design-classes src && node ../../node_modules/@simplix-react/ui/scripts/check-slot-spread.mjs src && node scripts/check-design-literals.mjs --test && node scripts/check-design-literals.mjs src"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "catalog:",
    "@fontsource/noto-sans-kr": "catalog:",
    "@simplix-react/headless": "catalog:",
    "lucide-react": "catalog:",
    "react-daum-postcode": "^3.2.0",
    "simplix-react": "catalog:",
    "simplix-react-ext": "catalog:",
    "tw-animate-css": "catalog:",
    "zustand": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@tanstack/react-query": ">=5.0.0",
    "@tanstack/react-router": ">=1.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "simplix": {
    "templates": "templates"
  }
}

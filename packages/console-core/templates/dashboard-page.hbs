/**
 * @simplix-generated page/{{@kit.id}}-dashboard-page
 *
 * A page of figures and panels, laid down from the {{@kit.label}} kit's `dashboard-page.hbs` as the
 * whole screen: its title, the description its catalog states, its figure tiles and its cards
 * (`DashboardCard` from `{{@kit.package}}/dashboard`) in a `DashboardGrid`, each card with its span (1, 2 or 4) and every row summing to four. The figures
 * and cards are written here, in this file; a later template change is merged into it three ways.
 */
import { useTranslation } from "@simplix-react/i18n/react";
import { DashboardGrid } from "{{@kit.package}}/dashboard";
import type { SettingsTile } from "{{@kit.package}}/layout";
import { ConsolePage } from "{{@kit.package}}/page";

/** {{NamePascal}}: figures and panels. */
export function {{NamePascal}}Page() {
  const { t } = useTranslation("{{namespace}}");
  // A key the catalog holds empty comes back as the key itself, and draws no line either.
  const line = t("{{nameCamel}}.description");
  const description = line && line !== "{{nameCamel}}.description" ? line : undefined;
  const tiles: SettingsTile[] = [];
  return (
    <ConsolePage
      spec={{ldb}}
        title: t("{{nameCamel}}.title"),
        description,
        tiles,
        // Cards are as tall as they are, so the page scrolls rather than a box inside it.
        layout: "flow",
        body: <DashboardGrid>{null}</DashboardGrid>,
      {{rdb}}
    />
  );
}

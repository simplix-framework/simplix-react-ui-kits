/**
 * @simplix-generated page/{{@kit.id}}-app-shell
 *
 * The app's window, laid down once from the {{@kit.label}} kit's `app-shell.hbs` and owned by the
 * app from then on. On a wide window: the top bar, the menu column (folding to a rail) and the
 * routed screen beside it, and the status strip under them. On a phone: one screen at a time, the
 * destinations marked as phone tabs along the bottom, and a menu sheet holding every group with
 * the window-level controls. The services beside the console stand at the foot of the column, the
 * rail and the sheet, each opened in a new tab. The menu, the brand, the top-bar controls, the
 * account menu and the services are this file's own, in `useShellParts` below, and are customised
 * here; `SHELL_FRAME` names the routes drawn without the window and the pages drawn in place of it
 * for a refused self read, so the shell's own reads run only once a session stands. The screens
 * reached without a session wear `AuthLayout`.
 */
import { Outlet, useRouter, useRouterState } from "@tanstack/react-router";
import { createElement, useCallback, useEffect, useMemo, useState, type ComponentType, type ReactNode } from "react";
import { PanelLeftCloseIcon, PanelLeftOpenIcon } from "lucide-react";
import { useTranslation } from "@simplix-react/i18n/react";
import {
  Button,
  Flex,
  PageHeaderProvider,
  Popover,
  PopoverTrigger,
  Stack,
  Tooltip,
  TooltipContent,
  TooltipTrigger,
  usePageHeaderState,
} from "@simplix-react/ui";
import { PeekHost } from "{{@kit.package}}/peek";
import { NoticeRegistryProvider, UNBUILT } from "{{@kit.package}}/notice";
import {
  AuthLayout,
  ChromeControlRows,
  ConsoleContentColumn,
  ConsoleMenuBranch,
  ConsoleMenuBranchRow,
  ConsoleMenuColumn,
  ConsoleMenuFlyout,
  ConsoleMenuFold,
  ConsoleMenuInactiveRow,
  ConsoleMenuLinkRow,
  ConsoleMenuRail,
  ConsoleMenuRailButton,
  ConsoleMenuSlot,
  ConsolePhoneMenuSection,
  ConsolePhoneMenuSheet,
  ConsolePhoneSearchButton,
  ConsolePhoneShell,
  ConsoleServiceLinks,
  ConsoleStatusStrip,
  ConsoleTopBar,
  type ConsoleCommand,
  type ConsolePhoneTab,
  type ConsoleSearch,
  type ConsoleServiceLink,
  type ConsoleSearchDestination,
  type ConsoleStatusStripProps,
  type ConsoleTopBarAccount,
  type ConsoleTopBarProps,
  ConsoleWindow,
  DarkModeToggle,
  LocalePicker,
  type ShellRefusalPages,
  type SidebarCollapse,
  useConsoleOnAPhone,
  type FederatedSearchSource,
  useConsoleSearch,
  useShellRefusalScreen,
  useSidebarCollapse,
} from "{{@kit.package}}/shell";

/** One destination in the menu. */
export interface ShellMenuEntry {
  readonly key: string;
  readonly label: string;
  readonly icon: ComponentType<{ "aria-hidden"?: boolean }>;
  /** Where it goes; absent where the screen is not built, and the row is drawn inactive. */
  readonly href?: string;
  /** Why an entry with no `href` cannot be opened, announced and shown on hover. */
  readonly inactiveReason?: string;
  /** The mark at the end of an entry with no `href`, saying which kind of unavailable it is. */
  readonly inactiveMark?: ReactNode;
  /** The icon of its phone tab, where the destination is one. */
  readonly phoneTab?: ConsolePhoneTab["icon"];
}

/** One group of destinations, already narrowed to what the signed-in account may open. */
export interface ShellMenuGroup {
  readonly key: string;
  readonly label: string;
  readonly icon: ComponentType<{ "aria-hidden"?: boolean }>;
  readonly entries: readonly ShellMenuEntry[];
}

export interface ShellParts {
  /** The name the shell keeps its own preferences under (the menu's fold). */
  readonly namespace: string;
  /**
   * The product's mark, the console's name and its badge, at the head of the top bar and the phone
   * bar; `home` is where pressing the mark leads and what that link is called for a screen reader.
   */
  readonly brand: { readonly mark?: ReactNode; readonly title: string; readonly badge?: ReactNode; readonly home?: { readonly href: string; readonly label: string } };
  readonly menuTitle?: ReactNode;
  readonly menu: readonly ShellMenuGroup[];
  /**
   * Destinations outside the groups, drawn after them: a row of their own in the column, a mark of
   * their own on the rail, and a row in the phone sheet's last section (a phone tab where marked).
   */
  readonly tail?: readonly ShellMenuEntry[];
  /** The top bar's areas, search, region, bell, help and settings controls. */
  readonly topBar: Omit<ConsoleTopBarProps, "mark" | "title" | "badge" | "account">;
  readonly account: ConsoleTopBarAccount;
  readonly status?: ConsoleStatusStripProps;
  /** Rows the phone's menu sheet ends with, after the `tail` entries (signing out). */
  readonly phoneFooter?: ReactNode;
  /**
   * The services beside the console (another app of the product, the sign-in server's admin console),
   * opened in a new tab from the foot of the menu column, the rail and the phone sheet. Each address
   * is the installation's to set, read from its environment; a service with none is not drawn.
   */
  readonly services?: ShellServices;
  /** What the console's search finds beyond the menu: records, this reader's recents, the product's actions. */
  readonly search?: ShellSearchParts;
  /** Providers the window needs around itself and the routed screens, mounted once per window. */
  readonly wrap: (shell: ReactNode) => ReactNode;
}

/** The services beside the console, under one name. */
export interface ShellServices {
  readonly title: string;
  readonly links: readonly ConsoleServiceLink[];
}

/**
 * What the console's search finds beyond the menu, which always lists the destinations above and
 * the console's own actions (language, light or dark, the menu's fold, the list of keys).
 */
export interface ShellSearchParts {
  /** The lists asked for records once two characters are typed, each gated on its list access. */
  readonly records?: readonly FederatedSearchSource[];
  /**
   * Where this reader's recents are kept: a key per signed-in account, outside the sign-in store's
   * prefix. Absent or `null`, no recents are kept.
   */
  readonly recentsKey?: string | null;
  /** The product's own actions, each a real operation the account may run. */
  readonly actions?: readonly ConsoleCommand[];
}

/** What the root layout decides before a session stands, read without running any of the parts. */
export interface ShellFrame {
  /** The routes drawn without the console window (sign-in and the pages around it). */
  readonly isOutsideTheConsole: (route: string) => boolean;
  /**
   * The page drawn in place of the whole shell while the server refuses the signed-in identity's own
   * read, by the error code its envelope carries. Absent, no refusal changes the shell.
   */
  readonly refusalPages?: ShellRefusalPages;
}

export const SHELL_FRAME: ShellFrame = {
  isOutsideTheConsole: () => false,
};

/** The shell's parts, read once per window and only once a session stands. */

export function useShellParts(): ShellParts {
  const { t } = useTranslation("{{namespace}}");
  return {
    namespace: "{{nameKebab}}",
    brand: { title: t("shell.title"), home: { href: "/", label: t("shell.title") } },
    menu: [],
    topBar: {
      areas: [{ key: "main", label: t("shell.area") }],
      area: "main",
      onArea: () => undefined,
      // Opened by the window's search, which `Console` wires to the palette.
      onSearch: UNBUILT,
      region: { label: t("shell.region"), empty: t("shell.noRegion"), items: [], onSelect: UNBUILT },
      notifications: { label: t("shell.notifications"), empty: t("shell.noNotifications"), onOpenChange: UNBUILT },
      onHelp: UNBUILT,
      unbuiltReason: t("shell.unbuilt"),
      settings: (
        <>
          <LocalePicker />
          <DarkModeToggle />
        </>
      ),
    },
    account: { name: "", menu: null },
    wrap: (shell) => shell,
  };
}

/** Picks the shell a screen wears: the sign-in shell outside the console, the window inside it. */
export function RootLayout() {
  // What the outlet renders, not where the router is heading: the previous route stays on screen
  // until the next one loads.
  const route = useRouterState({ select: (s) => s.matches[s.matches.length - 1]?.pathname ?? s.location.pathname });
  const frame = SHELL_FRAME;
  // Read before the branches below, so the hooks run in one order on every route.
  const onAPhone = useConsoleOnAPhone();
  // A refusal the frame names a page for replaces the whole shell, sign-in included: every read
  // behind it is refused the same way.
  const refusal = useShellRefusalScreen(frame.refusalPages);
  if (refusal) return refusal;
  if (frame.isOutsideTheConsole(route)) return <AuthLayout />;
  return (
    <PeekHost>
      <PageHeaderProvider>
        <NoticeRegistryProvider>
          <Console route={route} onAPhone={onAPhone} />
        </NoticeRegistryProvider>
      </PageHeaderProvider>
    </PeekHost>
  );
}

/**
 * The window once a session stands. The parts are read here and only here: their reads (the
 * account, its permissions) never run on the sign-in screens, and a block that must have a single
 * writer per window mounts once.
 */
function Console({ route, onAPhone }: { readonly route: string; readonly onAPhone: boolean }) {
  const shell = useShellParts();
  // The menu's fold is read here, so the search's fold action and the column are one state.
  const collapse = useSidebarCollapse(shell.namespace);
  const search = useShellSearch(shell, route, onAPhone ? undefined : collapse);
  // The top bar's search field opens the window's one palette.
  const parts: ShellParts = { ...shell, topBar: { ...shell.topBar, onSearch: search.open } };
  return parts.wrap(
    <>
      {onAPhone ? (
        <PhoneShell parts={parts} route={route} onSearch={search.open}>
          <Outlet />
        </PhoneShell>
      ) : (
        <WindowShell parts={parts} route={route} collapse={collapse}>
          <Outlet />
        </WindowShell>
      )}
      {search.element}
    </>,
  );
}

/** Every destination the account may open, in menu order, the `tail` entries last. */
function destinationsOf(parts: ShellParts): ConsoleSearchDestination[] {
  const destination = (entry: ShellMenuEntry, sub?: string): ConsoleSearchDestination[] =>
    entry.href ? [{ key: entry.key, label: entry.label, sub, icon: createElement(entry.icon, { "aria-hidden": true }), href: entry.href }] : [];
  return [...parts.menu.flatMap((group) => group.entries.flatMap((entry) => destination(entry, group.label))), ...(parts.tail ?? []).flatMap((entry) => destination(entry))];
}

/**
 * The window's search: the kit's palette over the menu the account may open and the parts'
 * `search`, opened by the top bar's field, the phone bar's glyph and ⌘K or Ctrl+K.
 */
function useShellSearch(parts: ShellParts, route: string, collapse?: SidebarCollapse): ConsoleSearch {
  const router = useRouter();
  const navigate = useCallback((href: string) => router.history.push(href), [router]);
  const entryKey = (entry: ShellMenuEntry) => `${entry.key}=${entry.label}=${entry.href ?? ""}`;
  const menuKey = [...parts.menu.map((group) => `${group.label}:${group.entries.map(entryKey).join(",")}`), ...(parts.tail ?? []).map(entryKey)].join("|");
  // The parts are rebuilt every render; the destinations change only when the menu's words or entries do.
  // eslint-disable-next-line react-hooks/exhaustive-deps
  const destinations = useMemo(() => destinationsOf(parts), [menuKey]);
  return useConsoleSearch({
    destinations,
    route,
    navigate,
    records: parts.search?.records,
    recentsKey: parts.search?.recentsKey ?? null,
    actions: parts.search?.actions,
    collapse,
  });
}

interface ShellProps {
  readonly parts: ShellParts;
  readonly route: string;
  readonly children: ReactNode;
}

function WindowShell({ parts, route, collapse, children }: ShellProps & { readonly collapse: SidebarCollapse }) {
  const { t } = useTranslation("{{namespace}}");
  const { collapsed, toggle } = collapse;
  return (
    <ConsoleWindow>
      <ConsoleTopBar {...parts.topBar} mark={parts.brand.mark} title={parts.brand.title} badge={parts.brand.badge} home={parts.brand.home} account={parts.account} />
      <Flex gap="none" flex overflow="hidden">
        <ConsoleMenuSlot>
          {collapsed ? (
            <ConsoleMenuRail
              label={t("shell.nav.rail")}
              lead={
                <Button variant="ghost" size="icon-sm" onClick={toggle} aria-label={t("shell.nav.expand")} title={t("shell.nav.expand")}>
                  <PanelLeftOpenIcon />
                </Button>
              }
              foot={parts.services ? <ConsoleServiceLinks layout="rail" {...parts.services} /> : undefined}
            >
              {parts.menu.map((group) => (
                <RailGroup key={group.key} group={group} route={route} />
              ))}
              {/* An entry outside the groups is a mark of its own, opening its one row. */}
              {parts.tail?.map((entry) => (
                <RailGroup key={entry.key} group=\{{ key: entry.key, label: entry.label, icon: entry.icon, entries: [entry] }} route={route} />
              ))}
            </ConsoleMenuRail>
          ) : (
            <ConsoleMenuColumn
              label={t("shell.nav.menu")}
              title={parts.menuTitle}
              action={
                <Button variant="ghost" size="icon-xs" onClick={toggle} aria-label={t("shell.nav.collapse")} title={t("shell.nav.collapse")}>
                  <PanelLeftCloseIcon />
                </Button>
              }
              foot={parts.services ? <ConsoleServiceLinks layout="column" {...parts.services} /> : undefined}
            >
              {parts.menu.map((group) => (
                <ColumnGroup key={group.key} group={group} route={route} />
              ))}
              {parts.tail?.map((entry) => (
                <EntryRow key={entry.key} entry={entry} route={route} />
              ))}
            </ConsoleMenuColumn>
          )}
        </ConsoleMenuSlot>
        <ConsoleContentColumn>{children}</ConsoleContentColumn>
      </Flex>
      {parts.status ? <ConsoleStatusStrip {...parts.status} /> : null}
    </ConsoleWindow>
  );
}

/** One group in the expanded column, open while the reader stands inside it. */
function ColumnGroup({ group, route }: { readonly group: ShellMenuGroup; readonly route: string }) {
  const inside = group.entries.some((entry) => holds(entry, route));
  const [open, setOpen] = useState(inside);
  // Arriving inside the group from elsewhere (the brand, a figure, a card's link) opens it, so the row
  // the reader stands on is shown as current; leaving it keeps whatever the reader chose.
  useEffect(() => {
    if (inside) setOpen(true);
  }, [inside]);
  return (
    <Stack gap="xs">
      <ConsoleMenuBranchRow weight="cluster" icon={<group.icon aria-hidden />} label={group.label} open={open} onToggle={() => setOpen(!open)} />
      <ConsoleMenuFold open={open}>
        <ConsoleMenuBranch ruled>
          {group.entries.map((entry) => (
            <EntryRow key={entry.key} entry={entry} route={route} />
          ))}
        </ConsoleMenuBranch>
      </ConsoleMenuFold>
    </Stack>
  );
}

/** One group on the rail: its mark, opening its rows beside the rail on hover or press. */
function RailGroup({ group, route }: { readonly group: ShellMenuGroup; readonly route: string }) {
  const [open, setOpen] = useState(false);
  return (
    <Popover open={open} onOpenChange={setOpen}>
      <PopoverTrigger asChild>
        <ConsoleMenuRailButton active={group.entries.some((entry) => holds(entry, route))} label={group.label} onMouseEnter={() => setOpen(true)}>
          <group.icon aria-hidden />
        </ConsoleMenuRailButton>
      </PopoverTrigger>
      <ConsoleMenuFlyout title={group.label} onMouseLeave={() => setOpen(false)}>
        {/* A press on a row leaves the screen under the flyout, so the flyout closes with it. */}
        <Stack gap="xs" onClickCapture={() => setOpen(false)}>
          {group.entries.map((entry) => (
            <EntryRow key={entry.key} entry={entry} route={route} />
          ))}
        </Stack>
      </ConsoleMenuFlyout>
    </Popover>
  );
}

/** A destination: a link where the screen exists, an inactive row naming why where it does not. */
function EntryRow({ entry, route }: { readonly entry: ShellMenuEntry; readonly route: string }) {
  if (!entry.href) {
    const row = (
      <ConsoleMenuInactiveRow icon={<entry.icon aria-hidden />} label={entry.label} mark={entry.inactiveMark} aria-description={entry.inactiveReason} />
    );
    // The reason is shown on hover as well as announced, since a row that cannot be opened and says
    // nothing reads as broken.
    if (!entry.inactiveReason) return row;
    return (
      <Tooltip>
        <TooltipTrigger asChild>{row}</TooltipTrigger>
        <TooltipContent>{entry.inactiveReason}</TooltipContent>
      </Tooltip>
    );
  }
  return <ConsoleMenuLinkRow icon={<entry.icon aria-hidden />} label={entry.label} href={entry.href} current={holds(entry, route)} />;
}

function PhoneShell({ parts, route, onSearch, children }: ShellProps & { readonly onSearch: () => void }) {
  const { t } = useTranslation("{{namespace}}");
  const header = usePageHeaderState();
  const [menuOpen, setMenuOpen] = useState(false);
  const tail = parts.tail ?? [];
  const entries = [...parts.menu.flatMap((group) => group.entries), ...tail];
  const tabs: ConsolePhoneTab[] = entries.flatMap((entry) =>
    entry.phoneTab && entry.href ? [{ key: entry.key, label: entry.label, icon: entry.phoneTab, to: entry.href }] : [],
  );
  tabs.push({ key: "menu", label: t("shell.nav.menu"), icon: "menu", onPress: () => setMenuOpen(true) });
  const standing = entries.find((entry) => entry.phoneTab && holds(entry, route));
  return (
    <ConsolePhoneShell
      brand={parts.brand.mark}
      home={parts.brand.home}
      title={header.title ?? parts.brand.title}
      actions={<ConsolePhoneSearchButton onOpen={onSearch} />}
      tabs={tabs}
      activeTab={menuOpen ? "menu" : (standing?.key ?? "")}
    >
      <ConsoleContentColumn>{children}</ConsoleContentColumn>
      <ConsolePhoneMenuSheet
        open={menuOpen}
        onOpenChange={setMenuOpen}
        title={parts.brand.title}
        footer={
          <>
            <ConsolePhoneMenuSection title={t("shell.nav.settings")}>
              <ChromeControlRows />
            </ConsolePhoneMenuSection>
            {parts.services ? <ConsoleServiceLinks layout="sheet" {...parts.services} /> : null}
            {tail.length > 0 || parts.phoneFooter ? (
              <ConsolePhoneMenuSection>
                {tail.map((entry) => (
                  <EntryRow key={entry.key} entry={entry} route={route} />
                ))}
                {parts.phoneFooter}
              </ConsolePhoneMenuSection>
            ) : null}
          </>
        }
      >
        {parts.menu.map((group) => (
          <ConsolePhoneMenuSection key={group.key} title={group.label}>
            {group.entries.map((entry) => (
              <EntryRow key={entry.key} entry={entry} route={route} />
            ))}
          </ConsolePhoneMenuSection>
        ))}
      </ConsolePhoneMenuSheet>
    </ConsolePhoneShell>
  );
}

/** Whether the reader is on the destination or somewhere under it. */
function holds(entry: ShellMenuEntry, route: string): boolean {
  return entry.href !== undefined && (route === entry.href || route.startsWith(`${entry.href}/`));
}

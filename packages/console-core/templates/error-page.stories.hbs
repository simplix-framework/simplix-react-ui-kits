/**
 * @simplix-generated story/{{@kit.id}}-error-page
 *
 * The board frame for {{NamePascal}}Page, laid down from the {{@kit.label}} kit's
 * `error-page.stories.hbs` and rewritten while its fingerprint matches. It draws the failure the
 * page draws by default (not found); customise it to the failure the page's blocks pick, with the
 * same words, and once edited it is kept, and `simplix generated` lists it.
 */
import type { Meta, StoryObj } from "@storybook/react";
import { NotFoundPage } from "{{@kit.package}}/error";

/**
 * A frame is drawn with kit parts only, never an icon library or a `className`: `FailurePage` for a
 * failure of the page's own, its icon by name through `Icon`, its buttons through `Button` (both
 * from the kit's `screen` segment). A failure the shell draws in place of itself stands outside
 * the console window, so it goes inside `WindowScreen` (from the kit's `error` segment) with
 * `parameters.consoleFrame` set to false.
 */
function Screen() {
  return <NotFoundPage />;
}

const meta: Meta<typeof Screen> = {
  title: "Generated/{{storyTitle}}",
  component: Screen,
};
export default meta;
type Story = StoryObj<typeof Screen>;

/** The page as it opens. */
export const Page: Story = {};

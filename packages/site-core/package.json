{
  "name": "@simplix-react-ui-kits/site-core",
  "version": "0.1.1-SNAPSHOT",
  "description": "Web site UI kit parts shared by every site design: the site shell, page column and pricing parts, each element marked with the slot a design draws",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simplix-framework/simplix-react-ui-kits.git",
    "directory": "packages/site-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./account": {
      "source": "./src/account/index.ts",
      "types": "./src/account/index.ts",
      "import": "./dist/account/index.js"
    },
    "./action": {
      "source": "./src/action/index.ts",
      "types": "./src/action/index.ts",
      "import": "./dist/action/index.js"
    },
    "./auth": {
      "source": "./src/auth/index.ts",
      "types": "./src/auth/index.ts",
      "import": "./dist/auth/index.js"
    },
    "./checkout": {
      "source": "./src/checkout/index.ts",
      "types": "./src/checkout/index.ts",
      "import": "./dist/checkout/index.js"
    },
    "./form": {
      "source": "./src/form/index.ts",
      "types": "./src/form/index.ts",
      "import": "./dist/form/index.js"
    },
    "./help": {
      "source": "./src/help/index.ts",
      "types": "./src/help/index.ts",
      "import": "./dist/help/index.js"
    },
    "./install": {
      "source": "./src/install/index.ts",
      "types": "./src/install/index.ts",
      "import": "./dist/install/index.js"
    },
    "./legal": {
      "source": "./src/legal/index.ts",
      "types": "./src/legal/index.ts",
      "import": "./dist/legal/index.js"
    },
    "./link": {
      "source": "./src/link/index.ts",
      "types": "./src/link/index.ts",
      "import": "./dist/link/index.js"
    },
    "./marketing": {
      "source": "./src/marketing/index.ts",
      "types": "./src/marketing/index.ts",
      "import": "./dist/marketing/index.js"
    },
    "./page": {
      "source": "./src/page/index.ts",
      "types": "./src/page/index.ts",
      "import": "./dist/page/index.js"
    },
    "./pricing": {
      "source": "./src/pricing/index.ts",
      "types": "./src/pricing/index.ts",
      "import": "./dist/pricing/index.js"
    },
    "./shell": {
      "source": "./src/shell/index.ts",
      "types": "./src/shell/index.ts",
      "import": "./dist/shell/index.js"
    },
    "./templates/*": "./templates/*",
    "./styles/*": "./src/styles/*",
    "./regions.json": "./regions.json",
    "./scripts/site-regions-rendered.mjs": "./scripts/site-regions-rendered.mjs"
  },
  "files": [
    "dist",
    "src",
    "templates",
    "scripts",
    "regions.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --no-clean --no-dts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-site-regions.mjs && oxlint src && simplix-design-classes src && simplix-slot-spread src && simplix-design-literals src && pnpm -s design:check",
    "test": "node scripts/check-site-regions.mjs --selftest && node scripts/site-regions-rendered.mjs --selftest && vitest run",
    "clean": "rm -rf dist .turbo",
    "design:css": "simplix-design-css --root . --out src/styles/designs/base.css",
    "design:check": "simplix-design-css --root . --out src/styles/designs/base.css --check"
  },
  "dependencies": {
    "simplix-react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "simplix": {
    "templates": "templates"
  }
}

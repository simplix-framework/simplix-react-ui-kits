/**
 * @simplix-generated page/{{@kit.id}}-static-page
 *
 * A page of the site, laid down from the {{@kit.label}} kit's `static-page.hbs` as the whole page: the
 * page column, its head (the title and the lede its catalog states) and its sections. What the page
 * says and holds is written here, in this file; a later template change is merged into it three
 * ways. The strings come from the `{{namespace}}` catalog: `{{nameCamel}}.title` and
 * `{{nameCamel}}.lede`.
 */
import type { ReactNode } from "react";
import { useOptionalTranslation } from "@simplix-react/i18n/react";
import { SitePage, SitePageHead } from "{{@kit.package}}/page";

/** Props for {@link {{NamePascal}}Page}. */
export interface {{NamePascal}}PageProps {
  /** The page's sections under its head, in reading order. */
  readonly children?: ReactNode;
}

/** {{NamePascal}}: one page of the site. */
export function {{NamePascal}}Page({ children }: {{NamePascal}}PageProps = {}) {
  const { t, tOr } = useOptionalTranslation("{{namespace}}");
  // A lede the catalog holds empty draws no line.
  const lede = tOr("{{nameCamel}}.lede", "") || undefined;
  return (
    <SitePage>
      <SitePageHead title={t("{{nameCamel}}.title")} lede={lede} />
      {children}
    </SitePage>
  );
}

/**
 * @simplix-generated page/{{@kit.id}}-app-shell
 *
 * The site's window, laid down once from the {{@kit.label}} kit's `app-shell.hbs` and owned by the app
 * from then on: the bar with the site's pages and the visitor's actions or the account, the routed
 * page, and the footer with the owner and the legal links. The brand, the pages, the actions, the
 * legal links, the language picker, the theme control and what wraps the routed pages are this file's own, in
 * `useShellParts` below, and are customised here. A page whose route does not exist yet is listed
 * without an address and is drawn as plain text, so no link leads nowhere. The strings come from the
 * `{{namespace}}` catalog (English and Korean in the same change): `shell.title`, `shell.documentTitle` (the tab's title: the page's heading, then the product), `shell.home`,
 * `shell.navLabel`, `shell.menu`, `shell.legal`, `shell.owner` and the label of each link, and the
 * error dialog's `errors.titles.<kind>`, `errors.unavailable`, `errors.fallback`, `errors.close` and
 * `errors.closeAll` (with `count`).
 *
 * <p>While the server refuses the signed-in identity's own read for a reason `refusalPages` names, that
 * page is drawn in place of the whole site, read from the boot access extension's refusal store.
 *
 * <p>The framework's failures and toasts are drawn once, by the site: the error dialog over the window
 * and the sign-in ground alike, the toasts inside the window. A product that also mounts the console's
 * provider stack switches the console's own surfaces off (`drawErrors={false}`, `drawToasts={false}`).
 *
 * <p>The colour scheme is the reader's choice, kept by `useSiteScheme`: the system's until the reader
 * picks light or dark in a theme control the parts hand to the footer. The page's head runs the kit's
 * `siteSchemeBootstrap()` so the first paint is already in that choice.
 */
import { Outlet, useRouter, useRouterState } from "@tanstack/react-router";
import type { ReactNode } from "react";
import { useSelfAccessRefusal } from "@simplix-react-ext/simplix-boot-access";
import { useTranslation } from "@simplix-react/i18n/react";
import { SiteErrors, SiteToasts, type SiteErrorsCopy } from "{{@kit.package}}/form";
import { routesInPage, type SiteLinkProps } from "{{@kit.package}}/link";
import { refusalPageFor, SiteBar, SiteFooter, SiteWindow, useSiteScheme, type SiteBarAccount, type SiteBarAction, type SiteBarLink, type SiteFooterLink, type SiteRefusalPages } from "{{@kit.package}}/shell";

export interface ShellParts {
  /** The product's mark at the bar's start, inside the link home. */
  readonly brand: ReactNode;
  /** The site's pages in reading order; one without an address is a page not open yet. */
  readonly links: readonly SiteBarLink[];
  /** The visitor's actions at the bar's end in reading order, such as signing in and starting for free. */
  readonly actions?: readonly SiteBarAction[];
  /** The signed-in account at the bar's end, drawn in place of the visitor's actions. */
  readonly account?: SiteBarAccount;
  /** The legal pages in the footer; one without an address is a page not open yet. */
  readonly legal: readonly SiteFooterLink[];
  /** The language picker at the footer's end. */
  readonly language?: ReactNode;
  /** The theme control (system, light, dark) after the language picker. */
  readonly theme?: ReactNode;
  /** The routes drawn without the window (signing in and the pages around it). */
  readonly isOutsideTheShell: (route: string) => boolean;
  /** Providers the routed page needs inside the window. */
  readonly wrap: (page: ReactNode) => ReactNode;
  /**
   * The page drawn in place of the whole site while the server refuses the signed-in identity's own
   * read, keyed by the error code its envelope carries. A refusal with no entry leaves the site as it is.
   */
  readonly refusalPages?: SiteRefusalPages;
}

/** The shell's parts for the route on screen, which the bar reads to mark where the reader stands. */
export function useShellParts(route: string): ShellParts {
  const { t } = useTranslation("{{namespace}}");
  return {
    brand: t("shell.title"),
    links: [{ key: "home", label: t("shell.home"), href: "/", current: route === "/" }],
    legal: [],
    isOutsideTheShell: () => false,
    wrap: (page) => page,
  };
}

/** The framework's error store (`dispatchError`), drawn once by the site in the words of the `{{namespace}}` catalog. */
function ShellErrors() {
  const { t } = useTranslation("{{namespace}}");
  const copy: SiteErrorsCopy = {
    titles: {
      validation: t("errors.titles.validation"),
      auth: t("errors.titles.auth"),
      client: t("errors.titles.client"),
      server: t("errors.titles.server"),
      network: t("errors.titles.network"),
      unknown: t("errors.titles.unknown"),
      gateway: t("errors.titles.gateway"),
    },
    unavailable: t("errors.unavailable"),
    fallback: t("errors.fallback"),
    close: t("errors.close"),
    closeAll: (count) => t("errors.closeAll", { count }),
  };
  return <SiteErrors copy={copy} />;
}

/**
 * The link every site part draws: an anchor with the real address, so it opens in a new tab too,
 * whose plain press on an address of the site moves the router instead of loading the page again.
 * A press the router does not answer (another origin's file or page, a download, a new tab) is the
 * browser's, so a page hands another site's address as a plain `href`.
 */
function RouterLink({ href, onClick, ...anchor }: SiteLinkProps) {
  const router = useRouter();
  return (
    <a
      {...anchor}
      href={href}
      onClick={(event) => {
        onClick?.(event);
        if (!routesInPage(event, href, anchor)) return;
        event.preventDefault();
        void router.navigate({ href });
      }}
    />
  );
}

/** Picks the shell a page wears: none for the routes drawn outside it, the site window otherwise. */
export function RootLayout() {
  useSiteScheme({ apply: true });
  const { t } = useTranslation("{{namespace}}");
  // What the outlet renders, not where the router is heading: the previous route stays on screen
  // until the next one loads.
  const route = useRouterState({ select: (s) => s.matches[s.matches.length - 1]?.pathname ?? s.location.pathname });
  const parts = useShellParts(route);
  // A refusal of the signed-in identity's own read replaces the whole site: every read behind it is
  // refused the same way.
  const Refused = refusalPageFor(parts.refusalPages, useSelfAccessRefusal());
  if (Refused)
    return (
      <>
        <Refused />
        <ShellErrors />
      </>
    );
  if (parts.isOutsideTheShell(route))
    return (
      <>
        <Outlet />
        <ShellErrors />
      </>
    );
  return (
    <>
    <SiteWindow
      page={route}
      linkComponent={RouterLink}
      title={(heading) => (heading === "" ? t("shell.title") : t("shell.documentTitle", { page: heading }))}
      bar={
        <SiteBar
          brand={parts.brand}
          brandHref="/"
          brandLabel={t("shell.home")}
          links={parts.links}
          navLabel={t("shell.navLabel")}
          moreLabel={t("shell.menu")}
          actions={parts.actions}
          account={parts.account}
        />
      }
      footer={<SiteFooter owner={t("shell.owner")} links={parts.legal} linksLabel={t("shell.legal")} language={parts.language} theme={parts.theme} />}
    >
      {parts.wrap(<Outlet />)}
      {/* The framework's toast store (`addToast`), drawn once by the site. */}
      <SiteToasts />
    </SiteWindow>
    <ShellErrors />
    </>
  );
}

/**
 * @simplix-generated page/{{@kit.id}}-error-page
 *
 * A failure page inside the site window, laid down from the {{@kit.label}} kit's `error-page.hbs` as
 * the whole page: the centred column with the round mark, the one heading, what happened and the
 * ways on, the first back to the site's start. The mark, the tone and any further way on are written
 * here, in this file; a later template change is merged into it three ways. The strings come from
 * the `{{namespace}}` catalog: `{{nameCamel}}.title`, `{{nameCamel}}.body` and `{{nameCamel}}.home`.
 */
import type { ReactNode } from "react";
import { useTranslation } from "@simplix-react/i18n/react";
import type { SiteActionSpec } from "{{@kit.package}}/action";
import { SiteFailure, SitePage } from "{{@kit.package}}/page";

/** Props for {@link {{NamePascal}}Page}. */
export interface {{NamePascal}}PageProps {
  /** The glyph in the round mark, a glyph the product draws. */
  readonly mark: ReactNode;
}

/** {{NamePascal}}: what went wrong, and the way back to the site. */
export function {{NamePascal}}Page({ mark }: {{NamePascal}}PageProps) {
  const { t } = useTranslation("{{namespace}}");
  const actions: readonly SiteActionSpec[] = [{ id: "home", label: t("{{nameCamel}}.home"), href: "/", tone: "primary" }];
  return (
    <SitePage rhythm="done">
      <SiteFailure mark={mark} title={t("{{nameCamel}}.title")} body={t("{{nameCamel}}.body")} actions={actions} />
    </SitePage>
  );
}

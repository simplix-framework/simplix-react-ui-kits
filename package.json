{
  "name": "simplix-react-ui-kits",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/check-declared-imports.mjs --selftest && node scripts/check-cycles.mjs --test && pnpm -r test",
    "lint": "node scripts/check-declared-imports.mjs && node scripts/check-cycles.mjs && pnpm -r lint",
    "check:imports": "node scripts/check-declared-imports.mjs",
    "local:link": "SIMPLIX_PROFILE=local pnpm install",
    "local:unlink": "SIMPLIX_PROFILE=registry pnpm install",
    "local:status": "node .pnpmfile.cjs status",
    "cycles": "node scripts/check-cycles.mjs"
  },
  "simplix": {
    "linkProfile": "registry",
    "frameworkPath": "../simplix-react"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}

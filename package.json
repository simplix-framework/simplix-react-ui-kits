{
  "name": "simplix-react-ui-kits",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/sync-design-kits.mjs --test && pnpm -r test && node testing/template-harness/run-all.mjs --parity-only && node testing/mockup-root/run.mjs",
    "lint": "simplix-declared-imports && simplix cycles packages tools --root . && simplix-em-dash packages && node scripts/sync-design-kits.mjs --check && node scripts/sync-version.mjs --check && pnpm -r lint",
    "sync-version": "node scripts/sync-version.mjs",
    "release": "node -e \"if(require('./package.json').version.endsWith('-SNAPSHOT')){console.error('Refusing to publish a -SNAPSHOT version; releases run via .github/workflows/release.yml');process.exit(1)}\" && pnpm sync-version && pnpm build && pnpm -r publish --access public",
    "check:imports": "simplix-declared-imports",
    "local:link": "SIMPLIX_PROFILE=local pnpm install",
    "local:unlink": "SIMPLIX_PROFILE=registry pnpm install",
    "local:status": "node .pnpmfile.cjs status",
    "cycles": "simplix cycles packages tools --root .",
    "test:templates": "node testing/template-harness/run-all.mjs",
    "test:mockup": "node testing/mockup-root/run.mjs"
  },
  "simplix": {
    "linkProfile": "auto",
    "frameworkPath": "../simplix-react"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "workspaces": ["packages/*", "testing/*"],
  "catalog": {
    "@storybook/react": "10.2.19",
    "msw": "^2.12.12",
    "zod": "^4.3.6",
    "@simplix-react/headless": "0.3.12",
    "simplix-react": "0.3.12",
    "simplix-react-ext": "0.3.12",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.167.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.0.0",
    "lucide-react": "^1.34.0",
    "oxlint": "^1.56.0",
    "react": "^19.2.4",
    "tw-animate-css": "^1.4.0",
    "tailwindcss": "4.2.1",
    "@tailwindcss/node": "4.2.1",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "zustand": "^5.0.12"
  }
}
